{
  "board": "guition_esp32_4848s040",
  "dashboard": {
    "screens": [
      {
        "id": "drive",
        "background_color": "#000000",
        "widgets": [
          {
            "type": "text",
            "id": "gear",
            "placement": {
              "x": 190,
              "y": 20,
              "width": 100,
              "height": 120
            },
            "sources": [
              {
                "binding": "transmission.gear"
              }
            ],
            "value": {
              "font": {
                "family": "display",
                "size_px": 96
              },
              "color": "#FFFFFF"
            }
          },
          {
            "type": "text",
            "id": "to-lap",
            "placement": {
              "x": 360,
              "y": 20,
              "width": 100,
              "height": 48
            },
            "sources": [
              {
                "binding": "session.lap.current",
                "transform": {
                  "type": "number",
                  "decimals": 0,
                  "prefix": "LAP "
                }
              }
            ],
            "value": {
              "font": {
                "family": "display",
                "size_px": 24
              },
              "color": "#7BE38A"
            },
            "border": {
              "width_px": 2,
              "radius_px": 8,
              "color": "#7BE38A"
            },
            "action": {
              "type": "goto_screen",
              "screen": "lap"
            }
          },
          {
            "type": "bar",
            "id": "revs",
            "placement": {
              "x": 20,
              "y": 150,
              "width": 440,
              "height": 28
            },
            "source": {
              "binding": "engine.rpm_percent"
            },
            "minimum": 0,
            "maximum": 100,
            "fill_color": "#FFE04A"
          },
          {
            "type": "slot",
            "id": "lower",
            "placement": {
              "x": 20,
              "y": 200,
              "width": 440,
              "height": 240
            },
            "pages": [
              {
                "widgets": [
                  {
                    "type": "text",
                    "id": "tyre-fl",
                    "placement": {
                      "x": 0,
                      "y": 0,
                      "width": 210,
                      "height": 110
                    },
                    "sources": [
                      {
                        "binding": "tyre.front_left.temperature",
                        "transform": {
                          "type": "number",
                          "decimals": 0,
                          "suffix": "C"
                        }
                      }
                    ],
                    "value": {
                      "font": {
                        "family": "display",
                        "size_px": 40
                      },
                      "color": "#E8E8E8"
                    }
                  },
                  {
                    "type": "text",
                    "id": "tyre-fr",
                    "placement": {
                      "x": 230,
                      "y": 0,
                      "width": 210,
                      "height": 110
                    },
                    "sources": [
                      {
                        "binding": "tyre.front_right.temperature",
                        "transform": {
                          "type": "number",
                          "decimals": 0,
                          "suffix": "C"
                        }
                      }
                    ],
                    "value": {
                      "font": {
                        "family": "display",
                        "size_px": 40
                      },
                      "color": "#E8E8E8"
                    }
                  }
                ]
              },
              {
                "widgets": [
                  {
                    "type": "text",
                    "id": "fuel-left",
                    "placement": {
                      "x": 0,
                      "y": 0,
                      "width": 440,
                      "height": 110
                    },
                    "sources": [
                      {
                        "binding": "vehicle.fuel.level",
                        "transform": {
                          "type": "number",
                          "decimals": 1,
                          "suffix": "L"
                        }
                      }
                    ],
                    "value": {
                      "font": {
                        "family": "display",
                        "size_px": 56
                      },
                      "color": "#7BE38A"
                    }
                  }
                ]
              },
              {
                "in_loop": false,
                "trigger": "value_changed",
                "source": {
                  "binding": "vehicle.aids.traction_control_active"
                },
                "duration_ms": 1500,
                "widgets": [
                  {
                    "type": "text",
                    "id": "tc-flash",
                    "placement": {
                      "x": 0,
                      "y": 20,
                      "width": 440,
                      "height": 120
                    },
                    "sources": [
                      {
                        "binding": "vehicle.aids.traction_control_level",
                        "transform": {
                          "type": "none",
                          "prefix": "TC "
                        }
                      }
                    ],
                    "value": {
                      "font": {
                        "family": "display",
                        "size_px": 72
                      },
                      "color": "#FFE04A"
                    }
                  }
                ]
              },
              {
                "in_loop": false,
                "trigger": "conditions",
                "source": {
                  "binding": "vehicle.pit_limiter.enabled"
                },
                "conditions": [
                  {
                    "op": "at_or_above",
                    "value": 1
                  }
                ],
                "duration_ms": 2000,
                "widgets": [
                  {
                    "type": "text",
                    "id": "pit-limiter",
                    "placement": {
                      "x": 0,
                      "y": 20,
                      "width": 440,
                      "height": 120
                    },
                    "sources": [
                      {
                        "binding": "vehicle.speed",
                        "transform": {
                          "type": "number",
                          "decimals": 0,
                          "prefix": "PIT "
                        }
                      }
                    ],
                    "value": {
                      "font": {
                        "family": "display",
                        "size_px": 72
                      },
                      "color": "#38BDF8"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "lap",
        "background_color": "#000000",
        "widgets": [
          {
            "type": "text",
            "id": "lap-current",
            "placement": {
              "x": 20,
              "y": 40,
              "width": 440,
              "height": 120
            },
            "sources": [
              {
                "binding": "session.lap.current_time",
                "transform": {
                  "type": "time",
                  "format": "duration_ms"
                }
              }
            ],
            "value": {
              "font": {
                "family": "display",
                "size_px": 72
              },
              "color": "#FFFFFF"
            }
          },
          {
            "type": "text",
            "id": "lap-delta",
            "placement": {
              "x": 20,
              "y": 200,
              "width": 440,
              "height": 100
            },
            "sources": [
              {
                "binding": "session.lap.delta",
                "transform": {
                  "type": "time",
                  "format": "signed_duration_ms"
                }
              }
            ],
            "value": {
              "font": {
                "family": "display",
                "size_px": 56
              },
              "color": "#E8E8E8"
            },
            "condition_source": {
              "binding": "session.lap.delta"
            },
            "conditions": [
              {
                "op": "below",
                "value": 0,
                "color": "#00C853"
              },
              {
                "op": "above",
                "value": 0,
                "color": "#D50000"
              }
            ]
          },
          {
            "type": "shape",
            "id": "back-zone",
            "placement": {
              "x": 0,
              "y": 400,
              "width": 480,
              "height": 80
            },
            "action": {
              "type": "previous_screen"
            }
          }
        ]
      }
    ]
  }
}
