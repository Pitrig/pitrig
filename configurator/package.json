{
  "name": "@pitrig/configurator",
  "version": "0.1.0",
  "productName": "Pitrig",
  "description": "Pitrig dashboard configurator",
  "author": "Illia Lukashchuk <contact.pitrig@gmail.com>",
  "desktopName": "pitrig.desktop",
  "homepage": "https://www.pitrig.com",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --config electron.vite.debug.config.ts --entry out-debug/main/index.js",
    "preview": "electron-vite preview",
    "build": "pnpm run typecheck && electron-vite build",
    "build:debug": "pnpm run typecheck && electron-vite build --config electron.vite.debug.config.ts",
    "package": "pnpm run build && electron-builder --config electron-builder.yml",
    "package:debug": "pnpm run build:debug && electron-builder --config electron-builder.debug.yml",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.debug.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  }
}
