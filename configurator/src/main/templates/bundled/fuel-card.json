{
  "format": "pitrig-dashboard-template",
  "format_version": 1,
  "name": "Fuel card",
  "description": "The fuel calculator on the 320 x 170 display, after benofficial2's iRacing fuel overlay: what is in the tank and what it is worth, with the stint clocks on the second screen.",
  "configuration": {
    "board": "t_display_s3",
    "dashboard": {
      "screens": [
        {
          "id": "fuel",
          "background_color": "#05070B",
          "widgets": [
            {
              "type": "text",
              "id": "u_fuel",
              "placement": {
                "x": 4,
                "y": 4,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.level",
                  "transform": {
                    "type": "number",
                    "decimals": 1
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 44
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "\ue546 ON BOARD",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13,
                  "fallback": "material-icons"
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "u_laps",
              "placement": {
                "x": 162,
                "y": 4,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.laps_remaining",
                  "transform": {
                    "type": "number",
                    "decimals": 1
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 44
                },
                "color": "#FFC400",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "LAPS LEFT",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "u_add",
              "placement": {
                "x": 4,
                "y": 88,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.to_add",
                  "transform": {
                    "type": "number",
                    "decimals": 1
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 44
                },
                "color": "#00E676",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "REFUEL",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "u_avg",
              "placement": {
                "x": 162,
                "y": 88,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.average_consumption",
                  "transform": {
                    "type": "number",
                    "decimals": 2
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 44
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "AVG / LAP",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            }
          ]
        },
        {
          "id": "stint",
          "background_color": "#05070B",
          "widgets": [
            {
              "type": "text",
              "id": "u_time",
              "placement": {
                "x": 4,
                "y": 4,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.time_remaining",
                  "transform": {
                    "type": "time",
                    "format": "clock_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 32
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "FUEL TIME",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "u_race",
              "placement": {
                "x": 162,
                "y": 4,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "session.time_remaining",
                  "transform": {
                    "type": "time",
                    "format": "clock_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 32
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "\ue8b5 RACE LEFT",
                "source": {
                  "binding": "session.type"
                },
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13,
                  "fallback": "material-icons"
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "u_need",
              "placement": {
                "x": 4,
                "y": 88,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.required_to_finish",
                  "transform": {
                    "type": "number",
                    "decimals": 1
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 44
                },
                "color": "#FF3B30",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "TO FINISH",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "u_last",
              "placement": {
                "x": 162,
                "y": 88,
                "width": 154,
                "height": 78
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.last_lap_consumption",
                  "transform": {
                    "type": "number",
                    "decimals": 2
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 44
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "background_color": "#0B0E14",
              "border": {
                "color": "#242A34",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "LAST LAP",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 13
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            }
          ]
        }
      ],
      "transition": "none"
    }
  }
}
