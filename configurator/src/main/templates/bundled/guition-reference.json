{
  "format": "simcore-dashboard-template",
  "format_version": 1,
  "name": "Guition reference dashboard",
  "description": "Every widget type that needs no uploaded asset, on a 480 x 480 square display: containers, an indicator strip, an arc, a bar, a graph and a slot.",
  "configuration": {
    "board": "guition_esp32_4848s040",
    "telemetry_transport": {
      "uart": {
        "baud_rate": 460800
      }
    },
    "dashboard": {
      "transition": "none",
      "screens": [
        {
          "id": "reference",
          "background_color": "#05070A",
          "widgets": [
            {
              "type": "indicator",
              "id": "revs",
              "placement": {
                "x": 8,
                "y": 8,
                "width": 464,
                "height": 34
              },
              "source": {
                "binding": "engine.rpm_percent"
              },
              "minimum": 0,
              "maximum": 100,
              "segment_gap_px": 5,
              "segment_radius_px": 3,
              "off_color": "#14181F",
              "blink_threshold": 0.97,
              "blink_ms": 140,
              "segments": [
                {
                  "threshold": 0,
                  "color": "#22C55E"
                },
                {
                  "threshold": 0.1,
                  "color": "#22C55E"
                },
                {
                  "threshold": 0.2,
                  "color": "#22C55E"
                },
                {
                  "threshold": 0.3,
                  "color": "#22C55E"
                },
                {
                  "threshold": 0.4,
                  "color": "#FFE04A"
                },
                {
                  "threshold": 0.5,
                  "color": "#FFE04A"
                },
                {
                  "threshold": 0.6,
                  "color": "#FFE04A"
                },
                {
                  "threshold": 0.7,
                  "color": "#FF8C1A"
                },
                {
                  "threshold": 0.8,
                  "color": "#FF3B30"
                },
                {
                  "threshold": 0.9,
                  "color": "#FF3B30"
                }
              ]
            },
            {
              "type": "shape",
              "id": "panel_gear",
              "placement": {
                "x": 8,
                "y": 50,
                "width": 232,
                "height": 206
              },
              "clip_children": false,
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 14
              },
              "title": {
                "text": "GEAR",
                "font": {
                  "family": "roboto_black",
                  "size_px": 14
                },
                "color": "#8A93A3"
              },
              "widgets": [
                {
                  "type": "text",
                  "id": "gear",
                  "placement": {
                    "x": 6,
                    "y": 6,
                    "width": 220,
                    "height": 194
                  },
                  "sources": [
                    {
                      "binding": "transmission.gear"
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto_black",
                      "size_px": 144
                    },
                    "color": "#FFFFFF",
                    "alignment": "center"
                  },
                  "condition_source": {
                    "binding": "engine.rpm_percent"
                  },
                  "conditions": [
                    {
                      "op": "at_or_above",
                      "value": 97,
                      "color": "#FF3B30",
                      "blink_ms": 150
                    },
                    {
                      "op": "at_or_above",
                      "value": 90,
                      "color": "#FFE04A"
                    }
                  ]
                }
              ]
            },
            {
              "type": "shape",
              "id": "panel_speed",
              "placement": {
                "x": 248,
                "y": 50,
                "width": 224,
                "height": 206
              },
              "clip_children": false,
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 14
              },
              "title": {
                "text": "SPEED",
                "font": {
                  "family": "roboto_black",
                  "size_px": 14
                },
                "color": "#8A93A3"
              },
              "widgets": [
                {
                  "type": "arc",
                  "id": "speed_arc",
                  "placement": {
                    "x": 16,
                    "y": 12,
                    "width": 192,
                    "height": 182
                  },
                  "source": {
                    "binding": "vehicle.speed"
                  },
                  "minimum": 0,
                  "maximum": 300,
                  "center_angle_deg": 270,
                  "sector_deg": 270,
                  "thickness_px": 14,
                  "track_color": "#1A202B",
                  "fill_color": "#38BDF8",
                  "z_index": 0
                },
                {
                  "type": "text",
                  "id": "speed_value",
                  "placement": {
                    "x": 42,
                    "y": 58,
                    "width": 140,
                    "height": 90
                  },
                  "z_index": 1,
                  "sources": [
                    {
                      "binding": "vehicle.speed"
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto_black",
                      "size_px": 50
                    },
                    "color": "#FFFFFF",
                    "alignment": "center"
                  }
                }
              ]
            },
            {
              "type": "bar",
              "id": "delta_bar",
              "placement": {
                "x": 8,
                "y": 264,
                "width": 464,
                "height": 44
              },
              "z_index": 0,
              "source": {
                "binding": "session.lap.delta"
              },
              "minimum": -5000,
              "maximum": 5000,
              "origin": 0,
              "background_color": "#14181F",
              "fill_color": "#FFE04A",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 10
              }
            },
            {
              "type": "text",
              "id": "delta_value",
              "placement": {
                "x": 8,
                "y": 264,
                "width": 464,
                "height": 44
              },
              "z_index": 1,
              "sources": [
                {
                  "binding": "session.lap.delta",
                  "transform": {
                    "type": "time",
                    "format": "signed_duration_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 28
                },
                "color": "#E8E8E8",
                "alignment": "center"
              },
              "condition_source": {
                "binding": "session.lap.delta"
              },
              "conditions": [
                {
                  "op": "below",
                  "value": 0,
                  "color": "#22C55E"
                },
                {
                  "op": "above",
                  "value": 0,
                  "color": "#FF3B30"
                }
              ]
            },
            {
              "type": "graph",
              "id": "inputs",
              "placement": {
                "x": 8,
                "y": 316,
                "width": 464,
                "height": 80
              },
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 10
              },
              "title": {
                "text": "INPUTS",
                "font": {
                  "family": "roboto_black",
                  "size_px": 14
                },
                "color": "#8A93A3"
              },
              "source": {
                "binding": "vehicle.throttle"
              },
              "minimum": 0,
              "maximum": 100,
              "point_count": 96,
              "sample_interval_ms": 50,
              "line_color": "#22C55E",
              "line_width_px": 2,
              "traces": [
                {
                  "source": {
                    "binding": "vehicle.brake"
                  },
                  "minimum": 0,
                  "maximum": 100,
                  "line_color": "#FF3B30"
                }
              ]
            },
            {
              "type": "shape",
              "id": "slot_plate",
              "placement": {
                "x": 8,
                "y": 404,
                "width": 464,
                "height": 68
              },
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 14
              },
              "z_index": 0
            },
            {
              "type": "slot",
              "id": "lower",
              "placement": {
                "x": 8,
                "y": 404,
                "width": 464,
                "height": 68
              },
              "clip_children": false,
              "pages": [
                {
                  "widgets": [
                    {
                      "type": "text",
                      "id": "water",
                      "placement": {
                        "x": 14,
                        "y": 12,
                        "width": 210,
                        "height": 46
                      },
                      "sources": [
                        {
                          "binding": "engine.water_temperature",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "suffix": "C"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto_black",
                          "size_px": 28
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "WATER",
                        "font": {
                          "family": "roboto_black",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    },
                    {
                      "type": "text",
                      "id": "oil",
                      "placement": {
                        "x": 240,
                        "y": 12,
                        "width": 210,
                        "height": 46
                      },
                      "sources": [
                        {
                          "binding": "engine.oil_temperature",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "suffix": "C"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto_black",
                          "size_px": 28
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "OIL",
                        "font": {
                          "family": "roboto_black",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    }
                  ]
                },
                {
                  "widgets": [
                    {
                      "type": "text",
                      "id": "fuel_left",
                      "placement": {
                        "x": 14,
                        "y": 12,
                        "width": 210,
                        "height": 46
                      },
                      "sources": [
                        {
                          "binding": "vehicle.fuel.level",
                          "transform": {
                            "type": "number",
                            "decimals": 1,
                            "suffix": "L"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto_black",
                          "size_px": 28
                        },
                        "color": "#38BDF8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "FUEL",
                        "font": {
                          "family": "roboto_black",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    },
                    {
                      "type": "text",
                      "id": "fuel_laps",
                      "placement": {
                        "x": 240,
                        "y": 12,
                        "width": 210,
                        "height": 46
                      },
                      "sources": [
                        {
                          "binding": "vehicle.fuel.laps_remaining",
                          "transform": {
                            "type": "number",
                            "decimals": 1
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto_black",
                          "size_px": 28
                        },
                        "color": "#38BDF8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "LAPS LEFT",
                        "font": {
                          "family": "roboto_black",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    }
                  ]
                },
                {
                  "in_loop": false,
                  "trigger": "conditions",
                  "source": {
                    "binding": "vehicle.pit_limiter.enabled"
                  },
                  "conditions": [
                    {
                      "op": "at_or_above",
                      "value": 1
                    }
                  ],
                  "duration_ms": 0,
                  "widgets": [
                    {
                      "type": "text",
                      "id": "pit_limiter",
                      "placement": {
                        "x": 14,
                        "y": 12,
                        "width": 436,
                        "height": 46
                      },
                      "sources": [
                        {
                          "binding": "vehicle.speed",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "prefix": "PIT "
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto_black",
                          "size_px": 28
                        },
                        "color": "#38BDF8",
                        "alignment": "center"
                      }
                    }
                  ]
                }
              ],
              "z_index": 1
            }
          ]
        }
      ]
    }
  }
}
