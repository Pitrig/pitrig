{
  "format": "pitrig-dashboard-template",
  "format_version": 1,
  "name": "Screens and slots",
  "description": "Two screens joined by tap targets, with a slot that cycles tyre and fuel pages and raises an alert page on a trigger.",
  "configuration": {
    "board": "guition_esp32_4848s040",
    "telemetry_transport": {
      "uart": {
        "baud_rate": 460800
      }
    },
    "dashboard": {
      "transition": "slide",
      "screens": [
        {
          "id": "drive",
          "background_color": "#05070A",
          "widgets": [
            {
              "type": "shape",
              "id": "panel_top",
              "placement": {
                "x": 8,
                "y": 8,
                "width": 464,
                "height": 132
              },
              "clip_children": false,
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 14
              },
              "widgets": [
                {
                  "type": "text",
                  "id": "gear",
                  "placement": {
                    "x": 6,
                    "y": 6,
                    "width": 204,
                    "height": 120
                  },
                  "sources": [
                    {
                      "binding": "transmission.gear"
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 96
                    },
                    "color": "#FFFFFF",
                    "alignment": "center"
                  },
                  "condition_source": {
                    "binding": "engine.rpm_percent"
                  },
                  "conditions": [
                    {
                      "op": "at_or_above",
                      "value": 97,
                      "color": "#FF3B30",
                      "blink_ms": 150
                    },
                    {
                      "op": "at_or_above",
                      "value": 90,
                      "color": "#FFE04A"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "speed",
                  "placement": {
                    "x": 220,
                    "y": 14,
                    "width": 110,
                    "height": 48
                  },
                  "sources": [
                    {
                      "binding": "vehicle.speed",
                      "transform": {
                        "type": "number",
                        "decimals": 0
                      }
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 40
                    },
                    "color": "#FFFFFF",
                    "alignment": "center"
                  },
                  "title": {
                    "text": "KM/H",
                    "font": {
                      "family": "roboto",
                      "size_px": 14
                    },
                    "color": "#8A93A3",
                    "alignment": "bottom_center"
                  }
                },
                {
                  "type": "text",
                  "id": "lap_count",
                  "placement": {
                    "x": 344,
                    "y": 14,
                    "width": 110,
                    "height": 48
                  },
                  "sources": [
                    {
                      "binding": "session.lap.current",
                      "transform": {
                        "type": "number",
                        "decimals": 0,
                        "prefix": "L"
                      }
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 40
                    },
                    "color": "#7BE38A",
                    "alignment": "center"
                  },
                  "title": {
                    "text": "LAP",
                    "font": {
                      "family": "roboto",
                      "size_px": 14
                    },
                    "color": "#8A93A3",
                    "alignment": "bottom_center"
                  }
                },
                {
                  "type": "text",
                  "id": "rpm",
                  "placement": {
                    "x": 220,
                    "y": 74,
                    "width": 234,
                    "height": 48
                  },
                  "sources": [
                    {
                      "binding": "engine.rpm"
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 40
                    },
                    "color": "#E8E8E8",
                    "alignment": "center"
                  },
                  "title": {
                    "text": "RPM",
                    "font": {
                      "family": "roboto",
                      "size_px": 14
                    },
                    "color": "#8A93A3",
                    "alignment": "bottom_center"
                  }
                }
              ]
            },
            {
              "type": "bar",
              "id": "revs",
              "placement": {
                "x": 8,
                "y": 148,
                "width": 464,
                "height": 28
              },
              "source": {
                "binding": "engine.rpm_percent"
              },
              "minimum": 0,
              "maximum": 100,
              "background_color": "#14181F",
              "fill_color": "#FFE04A",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 8
              }
            },
            {
              "type": "shape",
              "id": "slot_plate",
              "placement": {
                "x": 8,
                "y": 184,
                "width": 464,
                "height": 232
              },
              "z_index": 0,
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 14
              }
            },
            {
              "type": "slot",
              "id": "lower",
              "placement": {
                "x": 8,
                "y": 184,
                "width": 464,
                "height": 232
              },
              "z_index": 1,
              "clip_children": false,
              "pages": [
                {
                  "widgets": [
                    {
                      "type": "text",
                      "id": "tyre_fl",
                      "placement": {
                        "x": 10,
                        "y": 12,
                        "width": 216,
                        "height": 96
                      },
                      "sources": [
                        {
                          "binding": "tyre.front_left.temperature",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "suffix": "C"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 40
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "FL",
                        "font": {
                          "family": "roboto",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    },
                    {
                      "type": "text",
                      "id": "tyre_fr",
                      "placement": {
                        "x": 238,
                        "y": 12,
                        "width": 216,
                        "height": 96
                      },
                      "sources": [
                        {
                          "binding": "tyre.front_right.temperature",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "suffix": "C"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 40
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "FR",
                        "font": {
                          "family": "roboto",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    },
                    {
                      "type": "text",
                      "id": "tyre_rl",
                      "placement": {
                        "x": 10,
                        "y": 124,
                        "width": 216,
                        "height": 96
                      },
                      "sources": [
                        {
                          "binding": "tyre.rear_left.temperature",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "suffix": "C"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 40
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "RL",
                        "font": {
                          "family": "roboto",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    },
                    {
                      "type": "text",
                      "id": "tyre_rr",
                      "placement": {
                        "x": 238,
                        "y": 124,
                        "width": 216,
                        "height": 96
                      },
                      "sources": [
                        {
                          "binding": "tyre.rear_right.temperature",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "suffix": "C"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 40
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "RR",
                        "font": {
                          "family": "roboto",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    }
                  ]
                },
                {
                  "widgets": [
                    {
                      "type": "text",
                      "id": "fuel_left",
                      "placement": {
                        "x": 10,
                        "y": 12,
                        "width": 444,
                        "height": 96
                      },
                      "sources": [
                        {
                          "binding": "vehicle.fuel.level",
                          "transform": {
                            "type": "number",
                            "decimals": 1,
                            "suffix": "L"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 56
                        },
                        "color": "#7BE38A",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "FUEL",
                        "font": {
                          "family": "roboto",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    },
                    {
                      "type": "text",
                      "id": "fuel_avg",
                      "placement": {
                        "x": 10,
                        "y": 124,
                        "width": 216,
                        "height": 96
                      },
                      "sources": [
                        {
                          "binding": "vehicle.fuel.average_consumption",
                          "transform": {
                            "type": "number",
                            "decimals": 2,
                            "suffix": "L"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 40
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "AVG",
                        "font": {
                          "family": "roboto",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    },
                    {
                      "type": "text",
                      "id": "fuel_laps",
                      "placement": {
                        "x": 238,
                        "y": 124,
                        "width": 216,
                        "height": 96
                      },
                      "sources": [
                        {
                          "binding": "vehicle.fuel.laps_remaining",
                          "transform": {
                            "type": "number",
                            "decimals": 1
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 40
                        },
                        "color": "#E8E8E8",
                        "alignment": "center"
                      },
                      "title": {
                        "text": "LAPS LEFT",
                        "font": {
                          "family": "roboto",
                          "size_px": 14
                        },
                        "color": "#8A93A3"
                      }
                    }
                  ]
                },
                {
                  "in_loop": false,
                  "trigger": "value_changed",
                  "source": {
                    "binding": "vehicle.aids.traction_control_active"
                  },
                  "duration_ms": 1500,
                  "widgets": [
                    {
                      "type": "text",
                      "id": "tc_flash",
                      "placement": {
                        "x": 10,
                        "y": 60,
                        "width": 444,
                        "height": 112
                      },
                      "sources": [
                        {
                          "binding": "vehicle.aids.traction_control_level",
                          "transform": {
                            "type": "none",
                            "prefix": "TC "
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 72
                        },
                        "color": "#FFE04A",
                        "alignment": "center"
                      }
                    }
                  ]
                },
                {
                  "in_loop": false,
                  "trigger": "conditions",
                  "source": {
                    "binding": "vehicle.pit_limiter.enabled"
                  },
                  "conditions": [
                    {
                      "op": "at_or_above",
                      "value": 1
                    }
                  ],
                  "duration_ms": 2000,
                  "widgets": [
                    {
                      "type": "text",
                      "id": "pit_limiter",
                      "placement": {
                        "x": 10,
                        "y": 60,
                        "width": 444,
                        "height": 112
                      },
                      "sources": [
                        {
                          "binding": "vehicle.speed",
                          "transform": {
                            "type": "number",
                            "decimals": 0,
                            "prefix": "PIT "
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto",
                          "size_px": 72
                        },
                        "color": "#38BDF8",
                        "alignment": "center"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "shape",
              "id": "to_lap",
              "placement": {
                "x": 8,
                "y": 424,
                "width": 464,
                "height": 48
              },
              "border": {
                "color": "#7BE38A",
                "width_px": 2,
                "radius_px": 12
              },
              "title": {
                "text": "LAP TIMES >",
                "font": {
                  "family": "roboto",
                  "size_px": 24
                },
                "color": "#7BE38A",
                "alignment": "center"
              },
              "action": {
                "type": "next_screen"
              }
            }
          ]
        },
        {
          "id": "lap",
          "background_color": "#05070A",
          "widgets": [
            {
              "type": "shape",
              "id": "panel_current",
              "placement": {
                "x": 8,
                "y": 8,
                "width": 464,
                "height": 140
              },
              "clip_children": false,
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 14
              },
              "widgets": [
                {
                  "type": "text",
                  "id": "lap_current",
                  "placement": {
                    "x": 8,
                    "y": 14,
                    "width": 448,
                    "height": 112
                  },
                  "sources": [
                    {
                      "binding": "session.lap.current_time",
                      "modifiers": [
                        {
                          "type": "lap_timer"
                        }
                      ],
                      "transform": {
                        "type": "time",
                        "format": "duration_ms"
                      }
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 72
                    },
                    "color": "#FFFFFF",
                    "alignment": "center"
                  },
                  "title": {
                    "text": "CURRENT LAP",
                    "font": {
                      "family": "roboto",
                      "size_px": 14
                    },
                    "color": "#8A93A3"
                  }
                }
              ]
            },
            {
              "type": "shape",
              "id": "panel_delta",
              "placement": {
                "x": 8,
                "y": 156,
                "width": 464,
                "height": 120
              },
              "widgets": [
                {
                  "type": "bar",
                  "id": "delta_bar",
                  "placement": {
                    "x": 0,
                    "y": 0,
                    "width": 464,
                    "height": 120
                  },
                  "z_index": 0,
                  "source": {
                    "binding": "session.lap.delta"
                  },
                  "minimum": -5000,
                  "maximum": 5000,
                  "origin": 0,
                  "background_color": "#14181F",
                  "fill_color": "#FFE04A",
                  "border": {
                    "color": "#232A35",
                    "width_px": 2,
                    "radius_px": 14
                  }
                },
                {
                  "type": "text",
                  "id": "delta_value",
                  "placement": {
                    "x": 0,
                    "y": 0,
                    "width": 464,
                    "height": 120
                  },
                  "z_index": 1,
                  "sources": [
                    {
                      "binding": "session.lap.delta",
                      "transform": {
                        "type": "time",
                        "format": "signed_duration_ms"
                      }
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 56
                    },
                    "color": "#E8E8E8",
                    "alignment": "center"
                  },
                  "condition_source": {
                    "binding": "session.lap.delta"
                  },
                  "conditions": [
                    {
                      "op": "below",
                      "value": 0,
                      "color": "#22C55E"
                    },
                    {
                      "op": "above",
                      "value": 0,
                      "color": "#FF3B30"
                    }
                  ]
                }
              ]
            },
            {
              "type": "shape",
              "id": "panel_times",
              "placement": {
                "x": 8,
                "y": 292,
                "width": 464,
                "height": 120
              },
              "clip_children": false,
              "widgets": [
                {
                  "type": "text",
                  "id": "last_time",
                  "placement": {
                    "x": 0,
                    "y": 8,
                    "width": 224,
                    "height": 104
                  },
                  "sources": [
                    {
                      "binding": "session.lap.last_time",
                      "transform": {
                        "type": "time",
                        "format": "duration_ms"
                      }
                    }
                  ],
                  "border": {
                    "color": "#232A35",
                    "width_px": 2,
                    "radius_px": 14
                  },
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 40
                    },
                    "color": "#E8E8E8",
                    "alignment": "center"
                  },
                  "title": {
                    "text": "LAST",
                    "font": {
                      "family": "roboto",
                      "size_px": 14
                    },
                    "color": "#8A93A3"
                  }
                },
                {
                  "type": "text",
                  "id": "best_time",
                  "placement": {
                    "x": 240,
                    "y": 8,
                    "width": 224,
                    "height": 104
                  },
                  "sources": [
                    {
                      "binding": "session.lap.best_time",
                      "transform": {
                        "type": "time",
                        "format": "duration_ms"
                      }
                    }
                  ],
                  "border": {
                    "color": "#232A35",
                    "width_px": 2,
                    "radius_px": 14
                  },
                  "value": {
                    "font": {
                      "family": "roboto",
                      "size_px": 40
                    },
                    "color": "#22C55E",
                    "alignment": "center"
                  },
                  "title": {
                    "text": "BEST",
                    "font": {
                      "family": "roboto",
                      "size_px": 14
                    },
                    "color": "#22C55E"
                  }
                }
              ]
            },
            {
              "type": "shape",
              "id": "to_drive",
              "placement": {
                "x": 8,
                "y": 424,
                "width": 464,
                "height": 48
              },
              "border": {
                "color": "#38BDF8",
                "width_px": 2,
                "radius_px": 12
              },
              "title": {
                "text": "< DRIVE",
                "font": {
                  "family": "roboto",
                  "size_px": 24
                },
                "color": "#38BDF8",
                "alignment": "center"
              },
              "action": {
                "type": "previous_screen"
              }
            }
          ]
        }
      ]
    }
  }
}
