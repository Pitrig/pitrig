{
  "format": "simcore-dashboard-template",
  "format_version": 1,
  "name": "T-Display lap timer",
  "description": "Lap, delta, last and best readouts grouped into containers and sized for the 320 x 170 strip.",
  "configuration": {
    "board": "t_display_s3",
    "dashboard": {
      "transition": "none",
      "screens": [
        {
          "id": "lap",
          "background_color": "#05070A",
          "widgets": [
            {
              "type": "shape",
              "id": "panel_lap",
              "placement": {
                "x": 4,
                "y": 4,
                "width": 312,
                "height": 48
              },
              "clip_children": false,
              "background_color": "#0C1016",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 10
              },
              "widgets": [
                {
                  "type": "text",
                  "id": "lap_count",
                  "placement": {
                    "x": 6,
                    "y": 5,
                    "width": 84,
                    "height": 38
                  },
                  "sources": [
                    {
                      "binding": "session.lap.current",
                      "transform": {
                        "type": "number",
                        "decimals": 0,
                        "prefix": "L"
                      }
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto_black",
                      "size_px": 26
                    },
                    "color": "#8A93A3",
                    "alignment": "left"
                  }
                },
                {
                  "type": "text",
                  "id": "lap_time",
                  "placement": {
                    "x": 94,
                    "y": 5,
                    "width": 212,
                    "height": 38
                  },
                  "sources": [
                    {
                      "binding": "session.lap.current_time",
                      "modifiers": [
                        {
                          "type": "lap_timer"
                        }
                      ],
                      "transform": {
                        "type": "time",
                        "format": "duration_ms"
                      }
                    }
                  ],
                  "value": {
                    "font": {
                      "family": "roboto_black",
                      "size_px": 30
                    },
                    "color": "#FFFFFF",
                    "alignment": "right"
                  }
                }
              ]
            },
            {
              "type": "bar",
              "id": "delta_bar",
              "placement": {
                "x": 4,
                "y": 56,
                "width": 312,
                "height": 50
              },
              "z_index": 0,
              "source": {
                "binding": "session.lap.delta"
              },
              "minimum": -5000,
              "maximum": 5000,
              "origin": 0,
              "background_color": "#14181F",
              "fill_color": "#FFE04A",
              "border": {
                "color": "#232A35",
                "width_px": 2,
                "radius_px": 10
              }
            },
            {
              "type": "text",
              "id": "delta_value",
              "placement": {
                "x": 4,
                "y": 56,
                "width": 312,
                "height": 50
              },
              "z_index": 1,
              "sources": [
                {
                  "binding": "session.lap.delta",
                  "transform": {
                    "type": "time",
                    "format": "signed_duration_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 30
                },
                "color": "#E8E8E8",
                "alignment": "center"
              },
              "condition_source": {
                "binding": "session.lap.delta"
              },
              "conditions": [
                {
                  "op": "below",
                  "value": 0,
                  "color": "#22C55E"
                },
                {
                  "op": "above",
                  "value": 0,
                  "color": "#FF3B30"
                }
              ]
            },
            {
              "type": "shape",
              "id": "panel_times",
              "placement": {
                "x": 4,
                "y": 112,
                "width": 312,
                "height": 56
              },
              "clip_children": false,
              "widgets": [
                {
                  "type": "text",
                  "id": "last_time",
                  "placement": {
                    "x": 0,
                    "y": 6,
                    "width": 152,
                    "height": 46
                  },
                  "sources": [
                    {
                      "binding": "session.lap.last_time",
                      "transform": {
                        "type": "time",
                        "format": "duration_ms"
                      }
                    }
                  ],
                  "border": {
                    "color": "#232A35",
                    "width_px": 2,
                    "radius_px": 10
                  },
                  "title": {
                    "text": "LAST",
                    "font": {
                      "family": "roboto_black",
                      "size_px": 12
                    },
                    "color": "#8A93A3"
                  },
                  "value": {
                    "font": {
                      "family": "roboto_black",
                      "size_px": 26
                    },
                    "color": "#E8E8E8",
                    "alignment": "center"
                  }
                },
                {
                  "type": "text",
                  "id": "best_time",
                  "placement": {
                    "x": 160,
                    "y": 6,
                    "width": 152,
                    "height": 46
                  },
                  "sources": [
                    {
                      "binding": "session.lap.best_time",
                      "transform": {
                        "type": "time",
                        "format": "duration_ms"
                      }
                    }
                  ],
                  "border": {
                    "color": "#232A35",
                    "width_px": 2,
                    "radius_px": 10
                  },
                  "title": {
                    "text": "BEST",
                    "font": {
                      "family": "roboto_black",
                      "size_px": 12
                    },
                    "color": "#22C55E"
                  },
                  "value": {
                    "font": {
                      "family": "roboto_black",
                      "size_px": 26
                    },
                    "color": "#22C55E",
                    "alignment": "center"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
