                      "value": {
                        "font": {
                          "family": "roboto_bold",
                          "size_px": 35
                        },
                        "color": "#FFFFFF",
                        "alignment": "center",
                        "unavailable_text": "—",
                        "unavailable_color": "#8E949E"
                      },
                      "condition_source": {
                        "binding": "session.lap.delta"
                      },
                      "conditions": [
                        {
                          "op": "below",
                          "value": 0,
                          "color": "#14C95B"
                        },
                        {
                          "op": "above",
                          "value": 0,
                          "color": "#FF3B3B"
                        }
                      ]
                    },
