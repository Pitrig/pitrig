{
  "format": "pitrig-dashboard-template",
  "format_version": 1,
  "name": "T-Display lap timer",
  "description": "Lap, delta, last and best on a slot that a race-control flag takes over: red, black, mechanical, chequered, yellow, blue and white, each pulsing for as long as it is flown.",
  "configuration": {
    "board": "t_display_s3",
    "dashboard": {
      "transition": "none",
      "screens": [
        {
          "id": "lap",
          "background_color": "#000000",
          "widgets": [
            {
              "type": "slot",
              "id": "pages",
              "placement": {
                "x": 0,
                "y": 0,
                "width": 320,
                "height": 170
              },
              "pages": [
                {
                  "widgets": [
                    {
                      "type": "shape",
                      "id": "panel_lap",
                      "placement": {
                        "x": 4,
                        "y": 4,
                        "width": 312,
                        "height": 60
                      },
                      "background_color": "#131518",
                      "border": {
                        "color": "#2B2F36",
                        "width_px": 2,
                        "radius_px": 4
                      }
                    },
                    {
                      "type": "text",
                      "id": "lap_time",
                      "placement": {
                        "x": 16,
                        "y": 7,
                        "width": 288,
                        "height": 55
                      },
                      "sources": [
                        {
                          "binding": "session.lap.current_time",
                          "modifiers": [
                            {
                              "type": "lap_timer"
                            }
                          ],
                          "transform": {
                            "type": "time",
                            "format": "compact_duration_ms"
                          }
                        }
                      ],
                      "value": {
                        "font": {
                          "family": "roboto_bold",
                          "size_px": 60
                        },
                        "color": "#FFFFFF",
                        "alignment": "center",
                        "unavailable_text": "—",
                        "unavailable_color": "#8E949E"
                      }
                    },
                    {
                      "type": "shape",
                      "id": "delta_cont",
                      "placement": {
                        "x": 4,
                        "y": 72,
                        "width": 312,
                        "height": 34
                      },
                      "background_color": "#0B0C0E",
                      "border": {
                        "color": "#3A3F47",
                        "width_px": 2,
                        "radius_px": 4
                      }
                    },
                    {
                      "type": "text",
                      "id": "delta_value",
                      "placement": {
                        "x": 4,
                        "y": 72,
                        "width": 312,
                        "height": 34
                      },
                      "sources": [
                        {
                          "binding": "session.lap.delta",
                          "transform": {
                            "type": "time",
                            "format": "signed_digits_ms"
                          }
                        }
