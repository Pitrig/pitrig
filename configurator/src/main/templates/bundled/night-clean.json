{
  "format": "simcore-dashboard-template",
  "format_version": 1,
  "name": "Night clean",
  "description": "As little as will do, after Natto Nattino's Clean Dashboard Sport: rev lights, a huge gear between speed and lap time, the delta, and one quiet line of session numbers.",
  "configuration": {
    "board": "guition_jc1060p470c",
    "dashboard": {
      "screens": [
        {
          "id": "clean",
          "background_color": "#000000",
          "widgets": [
            {
              "type": "indicator",
              "id": "c_rev",
              "placement": {
                "x": 60,
                "y": 24,
                "width": 904,
                "height": 26
              },
              "source": {
                "binding": "engine.rpm_percent"
              },
              "minimum": 55,
              "maximum": 99,
              "segments": [
                {
                  "threshold": 0.0,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.062,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.125,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.188,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.25,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.312,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.375,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.438,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.5,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.562,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.625,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.688,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.75,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.812,
                  "color": "#FF3B30"
                },
                {
                  "threshold": 0.875,
                  "color": "#FF3B30"
                },
                {
                  "threshold": 0.938,
                  "color": "#FF3B30"
                }
              ],
              "segment_gap_px": 8,
              "segment_radius_px": 4,
              "off_color": "#101418",
              "blink_threshold": 0.985,
              "blink_ms": 110
            },
            {
              "type": "text",
              "id": "c_gear",
              "placement": {
                "x": 392,
                "y": 84,
                "width": 240,
                "height": 300
              },
              "sources": [
                {
                  "binding": "transmission.gear"
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 240
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "condition_source": {
                "binding": "engine.rpm_percent"
              },
              "conditions": [
                {
                  "op": "at_or_above",
                  "value": 98,
                  "color": "#FF3B30",
                  "blink_ms": 140
                },
                {
                  "op": "at_or_above",
                  "value": 94,
                  "color": "#FFC400"
                }
              ]
            },
            {
              "type": "text",
              "id": "c_speed",
              "placement": {
                "x": 60,
                "y": 150,
                "width": 300,
                "height": 160
              },
              "sources": [
                {
                  "binding": "vehicle.speed",
                  "transform": {
                    "type": "number",
                    "decimals": 0
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 132
                },
                "color": "#FFFFFF",
                "alignment": "right"
              },
              "title": {
                "text": "KMH",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 18
                },
                "color": "#626B79",
                "alignment": "bottom_right",
                "border_gap": false
              }
            },
            {
              "type": "text",
              "id": "c_lap",
              "placement": {
                "x": 664,
                "y": 150,
                "width": 300,
                "height": 160
              },
              "sources": [
                {
                  "binding": "session.lap.current_time",
                  "modifiers": [
                    {
                      "type": "lap_timer"
                    }
                  ],
                  "transform": {
                    "type": "time",
                    "format": "duration_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 64
                },
                "color": "#FFFFFF",
                "alignment": "left"
              },
              "title": {
                "text": "LAP",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 18
                },
                "color": "#626B79",
                "alignment": "top_left",
                "border_gap": false
              }
            },
            {
              "type": "text",
              "id": "c_best",
              "placement": {
                "x": 664,
                "y": 300,
                "width": 300,
                "height": 80
              },
              "sources": [
                {
                  "binding": "session.lap.best_time",
                  "transform": {
                    "type": "time",
                    "format": "duration_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 44
                },
                "color": "#626B79",
                "alignment": "left"
              }
            },
            {
              "type": "text",
              "id": "c_delta",
              "placement": {
                "x": 332,
                "y": 420,
                "width": 360,
                "height": 88
              },
              "sources": [
                {
                  "binding": "session.lap.delta",
                  "transform": {
                    "type": "time",
                    "format": "signed_duration_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 64
                },
                "color": "#000000",
                "alignment": "center"
              },
              "background_color": "#00E676",
              "border": {
                "radius_px": 8
              },
              "condition_source": {
                "binding": "session.lap.delta"
              },
              "conditions": [
                {
                  "op": "above",
                  "value": 0,
                  "color": "#FFFFFF",
                  "background_color": "#FF3B30"
                }
              ]
            },
            {
              "type": "text",
              "id": "c_fuel",
              "placement": {
                "x": 60,
                "y": 420,
                "width": 260,
                "height": 88
              },
              "sources": [
                {
                  "binding": "vehicle.fuel.level",
                  "transform": {
                    "type": "number",
                    "decimals": 1
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 48
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "border": {
                "width_px": 0,
                "radius_px": 8
              },
              "title": {
                "text": "\ue546 FUEL",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 15,
                  "fallback": "material-icons"
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "c_pos",
              "placement": {
                "x": 704,
                "y": 420,
                "width": 260,
                "height": 88
              },
              "sources": [
                {
                  "binding": "session.position",
                  "transform": {
                    "type": "number",
                    "decimals": 0
                  }
                },
                {
                  "binding": "session.participants",
                  "transform": {
                    "type": "number",
                    "decimals": 0,
                    "prefix": "/"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 48
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "border": {
                "width_px": 0,
                "radius_px": 8
              },
              "title": {
                "text": "POS",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 15
                },
                "color": "#626B79",
                "alignment": "top_center"
              }
            },
            {
              "type": "text",
              "id": "c_laps",
              "placement": {
                "x": 60,
                "y": 524,
                "width": 904,
                "height": 52
              },
              "sources": [
                {
                  "binding": "session.lap.current",
                  "transform": {
                    "type": "number",
                    "decimals": 0
                  }
                },
                {
                  "binding": "session.lap.total",
                  "transform": {
                    "type": "number",
                    "decimals": 0,
                    "prefix": "/"
                  }
                },
                {
                  "binding": "session.time_remaining",
                  "transform": {
                    "type": "time",
                    "format": "clock_ms",
                    "prefix": "   \ue8b5 "
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 34,
                  "fallback": "material-icons"
                },
                "color": "#626B79",
                "alignment": "center"
              }
            }
          ]
        }
      ],
      "transition": "none"
    }
  }
}
