{
  "format": "simcore-dashboard-template",
  "format_version": 1,
  "name": "Rallye stage",
  "description": "A minimal stage dashboard for the 320 x 170 display: rev lights, gear and speed, the lap timer with its delta, and a second screen of lap times, fuel and aids.",
  "configuration": {
    "board": "t_display_s3",
    "dashboard": {
      "screens": [
        {
          "id": "stage",
          "background_color": "#000000",
          "widgets": [
            {
              "type": "indicator",
              "id": "a_rev",
              "placement": {
                "x": 4,
                "y": 4,
                "width": 312,
                "height": 16
              },
              "source": {
                "binding": "engine.rpm_percent"
              },
              "minimum": 55,
              "maximum": 99,
              "segments": [
                {
                  "threshold": 0.0,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.062,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.125,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.188,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.25,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.312,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.375,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.438,
                  "color": "#00E676"
                },
                {
                  "threshold": 0.5,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.562,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.625,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.688,
                  "color": "#FFC400"
                },
                {
                  "threshold": 0.75,
                  "color": "#FF2D2D"
                },
                {
                  "threshold": 0.812,
                  "color": "#FF2D2D"
                },
                {
                  "threshold": 0.875,
                  "color": "#FF2D2D"
                },
                {
                  "threshold": 0.938,
                  "color": "#FF2D2D"
                }
              ],
              "segment_gap_px": 3,
              "segment_radius_px": 3,
              "off_color": "#15171C",
              "blink_threshold": 0.985,
              "blink_ms": 110
            },
            {
              "type": "text",
              "id": "a_gear",
              "placement": {
                "x": 4,
                "y": 22,
                "width": 66,
                "height": 92
              },
              "sources": [
                {
                  "binding": "transmission.gear"
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 76
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "background_color": "#0B0C0F",
              "border": {
                "color": "#282B32",
                "width_px": 2,
                "radius_px": 8
              },
              "condition_source": {
                "binding": "engine.rpm_percent"
              },
              "conditions": [
                {
                  "op": "at_or_above",
                  "value": 98,
                  "color": "#FFFFFF",
                  "background_color": "#FF2D2D",
                  "blink_ms": 140
                },
                {
                  "op": "at_or_above",
                  "value": 94,
                  "color": "#FF2D2D"
                }
              ]
            },
            {
              "type": "text",
              "id": "a_speed",
              "placement": {
                "x": 4,
                "y": 118,
                "width": 66,
                "height": 48
              },
              "sources": [
                {
                  "binding": "vehicle.speed",
                  "transform": {
                    "type": "number",
                    "decimals": 0
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 34
                },
                "color": "#000000",
                "alignment": "center"
              },
              "background_color": "#FFFFFF",
              "border": {
                "radius_px": 8
              }
            },
            {
              "type": "text",
              "id": "a_lap",
              "placement": {
                "x": 76,
                "y": 22,
                "width": 164,
                "height": 46
              },
              "sources": [
                {
                  "binding": "session.lap.current_time",
                  "modifiers": [
                    {
                      "type": "lap_timer"
                    }
                  ],
                  "transform": {
                    "type": "time",
                    "format": "duration_ms"
                  }
                }
              ],
              "value": {
                "font": {
                  "family": "roboto_black",
                  "size_px": 30
                },
                "color": "#FFFFFF",
                "alignment": "center"
              },
              "background_color": "#0B0C0F",
              "border": {
                "color": "#282B32",
                "width_px": 2,
                "radius_px": 8
              },
              "title": {
                "text": "LAP",
                "font": {
                  "family": "roboto-condensed_bold",
                  "size_px": 12
                },
                "color": "#69717D"
              }
