+static void lvgl_port_sched_task(void *arg)
+{
+    lvgl_port_display_ctx_t *ctx = (lvgl_port_display_ctx_t *)arg;
+    for (;;) {
+        if (xSemaphoreTake(ctx->sched_sem, pdMS_TO_TICKS(100)) != pdTRUE) {
+            lvgl_port_task_wake(LVGL_PORT_EVENT_DISPLAY, NULL);
+            continue;
+        }
+        const uint32_t period = ctx->vsync_period_us;
+        lvgl_port_sched_peak_us = ctx->mode_cost_peak[ctx->mode_best];
+        lvgl_port_sched_ema_us = ctx->mode_cost_ema[ctx->mode_best];
+        lvgl_port_sched_best = ctx->mode_best;
+        lvgl_port_sched_settled = ctx->mode_settled;
+        if (period == 0U || !ctx->mode_settled) {
+            lvgl_port_sched_fallback++;
+            lvgl_port_sched_fb_unsettled++;
+            ctx->sched_armed = 0U;
+            ctx->sched_pending = 1U;
+            ctx->wake_source = 3U;
+            lvgl_port_task_wake(LVGL_PORT_EVENT_DISPLAY, NULL);
+            continue;
+        }
+        const uint32_t cost = ctx->mode_cost_peak[ctx->mode_best] + ctx->jit_margin_us;
+        const int64_t now = esp_timer_get_time();
+        const uint32_t feed_period = ctx->feed_period_us;
+        const uint32_t burst_age = (uint32_t)now - ctx->feed_burst_lo32;
+        const bool tracked = feed_period != 0U && burst_age < feed_period * 3U;
+        lvgl_port_pkt_allow_us = ctx->pkt_allow_us;
+        lvgl_port_pkt_period_us = feed_period;
+        if (cost + ctx->pkt_allow_us + 3000U >= period) {
+            ctx->heavy = 1U;
+            ctx->heavy_calm = 0U;
+        } else if (cost + ctx->pkt_allow_us + 5000U < period) {
+            if (ctx->heavy_calm < 0xFFFFU) {
+                ctx->heavy_calm++;
+            }
+            if (ctx->heavy_calm >= 120U) {
+                ctx->heavy = 0U;
+            }
+        } else {
+            ctx->heavy_calm = 0U;
+        }
+        if (tracked && !ctx->heavy) {
+            lvgl_port_sched_tracked++;
+            if (!esp_timer_is_active(ctx->sched_timer)) {
+                const int32_t until_pkt = (int32_t)(ctx->next_pkt_lo32 - (uint32_t)now);
+                int64_t fire_at = now + until_pkt + (int64_t)ctx->pkt_allow_us + (int64_t)(period / 2U);
+                if (fire_at < now + 300) {
+                    fire_at = now + 300;
+                }
+                ctx->fire_kind = 1U;
+                lvgl_port_sched_timed++;
+                esp_timer_start_once(ctx->sched_timer, (uint64_t)(fire_at - now));
+            }
+            continue;
+        }
+        lvgl_port_sched_untracked++;
+        const int64_t fire_at = ctx->last_vsync_us + (int64_t)period - (int64_t)cost;
+        if (ctx->heavy || fire_at <= now + 200) {
