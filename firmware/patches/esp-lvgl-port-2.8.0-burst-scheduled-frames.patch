+static void lvgl_port_disp_note_feed_burst(int64_t now)
+{
+#ifdef CONFIG_SIMCORE_DISPLAY_VSYNC_LOCK
+    lvgl_port_display_ctx_t *ctx = s_strips_ctx;
+    if (ctx == NULL) {
+        return;
+    }
+    const uint32_t previous = ctx->feed_burst_lo32;
+    const uint32_t gap = (uint32_t)now - previous;
+    if (previous != 0U && gap >= 4000U && gap <= 250000U) {
+        if (ctx->feed_period_us != 0U) {
+            const uint32_t dev = gap > ctx->feed_period_us ? gap - ctx->feed_period_us
+                                                           : ctx->feed_period_us - gap;
+            ctx->feed_jitter_us = ctx->feed_jitter_us - (ctx->feed_jitter_us >> 4) + (dev >> 4);
+            lvgl_port_feed_jitter_us = ctx->feed_jitter_us;
+        }
+        ctx->feed_period_us = ctx->feed_period_us == 0U
+                              ? gap
+                              : ctx->feed_period_us - (ctx->feed_period_us >> 2) + (gap >> 2);
+    } else if (previous != 0U) {
+        ctx->feed_period_us = 0U;
+    }
+    ctx->feed_burst_lo32 = (uint32_t)now;
+    ctx->next_pkt_lo32 = (uint32_t)now + ctx->feed_period_us;
+    const uint32_t period = ctx->vsync_period_us;
+    if (period != 0U && ctx->mode_settled && !ctx->heavy && ctx->sched_timer != NULL) {
+        ctx->armed_empty = 0U;
+        ctx->fire_kind = 4U;
+        esp_timer_stop(ctx->sched_timer);
+        esp_timer_start_once(ctx->sched_timer, (uint64_t)ctx->pkt_allow_us);
+        lvgl_port_sched_burst_armed++;
+    }
+    if (ctx->pkt_quiet_run < 0xFFFFU) {
+        ctx->pkt_quiet_run++;
+    }
+    if (ctx->pkt_quiet_run >= 128U && ctx->pkt_allow_us > 300U) {
+        ctx->pkt_allow_us -= 100U;
+        ctx->pkt_quiet_run = 0U;
+    }
+    lvgl_port_pkt_bursts++;
+#else
+    (void)now;
+#endif
+}
