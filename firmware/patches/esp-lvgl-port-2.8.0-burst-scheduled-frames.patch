+static void lvgl_port_sched_timer_cb(void *arg)
+{
+    lvgl_port_display_ctx_t *ctx = (lvgl_port_display_ctx_t *)arg;
+    lvgl_port_sched_fired++;
+    if (ctx->swap_pending) {
+        const uint32_t period = ctx->vsync_period_us;
+        const int64_t now = esp_timer_get_time();
+        int64_t next_latch = ctx->last_vsync_us + (int64_t)period;
+        while (period != 0U && next_latch <= now) {
+            next_latch += (int64_t)period;
+        }
+        const uint32_t peak = ctx->mode_cost_peak[ctx->mode_best];
+        const uint32_t room = peak + 1000U + ctx->feed_jitter_us * 2U;
+        if (period != 0U && now + (int64_t)room < next_latch) {
+            lvgl_port_sched_deferred++;
+            return;
+        }
+        lvgl_port_sched_blocked++;
+    }
+    ctx->sched_armed = ctx->fire_kind == 1U ? 1U : 0U;
+    ctx->sched_pending = 1U;
+    ctx->wake_source = ctx->fire_kind;
+    lvgl_port_task_wake(LVGL_PORT_EVENT_DISPLAY, NULL);
+}
