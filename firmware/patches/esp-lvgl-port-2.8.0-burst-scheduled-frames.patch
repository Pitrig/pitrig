+void lvgl_port_disp_note_feed_line(void)
+{
+    const int64_t now_us = esp_timer_get_time();
+    const uint32_t now = (uint32_t)now_us;
+    const uint32_t gap = now - s_pkt_last_line_lo32;
+    const bool first = s_pkt_last_line_lo32 == 0U;
+    s_pkt_last_line_lo32 = now;
+    lvgl_port_pkt_lines++;
+    if (first || gap >= 3000U) {
+        lvgl_port_disp_note_feed_burst(now_us);
+    }
+}
