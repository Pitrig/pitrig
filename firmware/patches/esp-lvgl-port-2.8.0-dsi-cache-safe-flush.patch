+static void lvgl_port_adaptive_refr_start_callback(lv_event_t *e)
+{
+    lvgl_port_display_ctx_t *disp_ctx = (lvgl_port_display_ctx_t *)lv_event_get_user_data(e);
+    lv_display_t *disp = disp_ctx->disp_drv;
+    /* Whether repainting the whole frame beats reconciling the stale rows
+     * depends on how the dashboard draws, not on how much of it changed —
+     * so measure instead of guessing: run mostly in the mode with the lower
+     * frame-cost average, and probe the other one for a few frames out of
+     * every 64. Both modes are correct, so switching costs nothing. */
+    uint8_t mode = disp_ctx->mode_best;
+    disp_ctx->probe_tick = (uint16_t)((disp_ctx->probe_tick + 1U) & 1023U);
+    const uint32_t best_cost = disp_ctx->mode_cost_ema[disp_ctx->mode_best];
+    const uint32_t other_cost = disp_ctx->mode_cost_ema[disp_ctx->mode_best ^ 1U];
+    /* Probing the losing mode costs a burst of slow frames — a visible hiccup.
+     * At panel lock nothing can beat the panel, so probing is pointless; when
+     * the loser is far behind, checking it once in a while is plenty. */
+    const uint16_t probe_mask = other_cost < best_cost + (best_cost >> 1) ? 127U : 1023U;
+    if (best_cost > 17500U && (disp_ctx->probe_tick & probe_mask) < 4U) {
+        mode = disp_ctx->mode_best ^ 1U;
+    }
+    disp_ctx->frame_full = mode;
+    disp_ctx->frame_t0 = esp_timer_get_time();
+    if (mode != 0U) {
+        lv_obj_t *screen = lv_display_get_screen_active(disp);
+        if (screen != NULL) {
+            lv_obj_invalidate(screen);
+        }
+    }
+}
+
+static void lvgl_port_flush_worker(void *arg)
+{
+    lvgl_port_flush_job_t job;
+    (void)arg;
+    for (;;) {
+        if (xQueueReceive(s_flush_queue, &job, portMAX_DELAY) != pdTRUE) {
+            continue;
+        }
+        if (job.reconcile) {
+            /* A new frame opened in a stale buffer: refresh the row band other
+             * frames painted since this buffer was last drawn, so the parts
+             * this frame does not repaint still show the previous frame. */
+            lvgl_port_display_ctx_t *ctx = job.ctx;
+            const uint32_t px_size = lv_color_format_get_size(lv_display_get_color_format(job.drv));
+            const uint32_t stride = (uint32_t)lv_disp_get_hor_res(job.drv) * px_size;
+            const size_t band_offset = (size_t)job.y1 * stride;
+            const size_t band_bytes = (size_t)(job.y2 - job.y1) * stride;
+            uint8_t *dst_fb = (uint8_t *)ctx->panel_fbs[job.target] + band_offset;
+            uint8_t *src_fb = (uint8_t *)ctx->panel_fbs[job.source] + band_offset;
+            bool copied = false;
+#if (SOC_MIPI_DSI_SUPPORTED && ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 3, 0))
+            if (ctx->mcp != NULL) {
+                const size_t chunk = 320U * 1024U;
+                size_t offset = 0;
+                copied = true;
+                while (offset < band_bytes && copied) {
+                    const size_t length = (band_bytes - offset) < chunk ? (band_bytes - offset) : chunk;
+                    if (esp_async_memcpy(ctx->mcp, dst_fb + offset, src_fb + offset, length,
+                                         lvgl_port_flush_mcp_done_callback, ctx) == ESP_OK) {
+                        xSemaphoreTake(ctx->mcp_done, portMAX_DELAY);
+                        offset += length;
+                    } else {
+                        copied = false;
+                    }
+                }
+            }
+#endif
+            if (!copied) {
+                memcpy(dst_fb, src_fb, band_bytes);
+#if (SOC_MIPI_DSI_SUPPORTED && ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 3, 0))
+                esp_cache_msync(dst_fb, band_bytes,
+                                ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_INVALIDATE);
+#endif
+            }
+            __atomic_sub_fetch(&s_flush_pending, 1, __ATOMIC_SEQ_CST);
+            continue;
+        }
+        if (job.strip) {
+            /* Reconciled-strips mode: the damage was blended in internal RAM;
+             * carry it into the hidden frame buffer (DMA when the chunk is
+             * full-width and contiguous), and the frame's last chunk queues
+             * the swap the panel executes at the frame boundary. */
+            lvgl_port_display_ctx_t *ctx = job.ctx;
+            uint8_t *fb = (uint8_t *)ctx->panel_fbs[job.target];
+            const uint32_t px_size = lv_color_format_get_size(lv_display_get_color_format(job.drv));
+            const uint32_t hres = (uint32_t)lv_disp_get_hor_res(job.drv);
+            const uint32_t row_bytes = (uint32_t)(job.x2 - job.x1) * px_size;
+            const uint32_t rows = (uint32_t)(job.y2 - job.y1);
+            uint8_t *dst = fb + ((uint32_t)job.y1 * hres + (uint32_t)job.x1) * px_size;
+            bool copied = false;
+#if (SOC_MIPI_DSI_SUPPORTED && ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 3, 0))
+            lvgl_port_recon_wait(ctx, (uint16_t)job.x1, (uint16_t)job.y1,
+                                 (uint16_t)job.x2, (uint16_t)job.y2);
+            if (ctx->mcp != NULL && row_bytes == hres * px_size) {
+                if (esp_async_memcpy(ctx->mcp, dst, (void *)job.color_map,
+                                     (size_t)row_bytes * rows,
+                                     lvgl_port_flush_mcp_done_callback, ctx) == ESP_OK) {
+                    if (xSemaphoreTake(ctx->mcp_done, pdMS_TO_TICKS(500)) == pdTRUE) {
+                        copied = true;
+                    } else {
+                        ctx->mcp = NULL;
+                    }
+                }
+            }
+#endif
+            if (!copied) {
+                const uint8_t *src_row = job.color_map;
+                for (int y = job.y1; y < job.y2; y++) {
+                    memcpy(fb + ((uint32_t)y * hres + (uint32_t)job.x1) * px_size, src_row, row_bytes);
+                    src_row += row_bytes;
+                }
+#if (SOC_MIPI_DSI_SUPPORTED && ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 3, 0))
+                /* CPU writes went through the cache; push them out and drop the
+                 * lines so a later eviction cannot overwrite DMA-written rows. */
+                esp_cache_msync(fb + (uint32_t)job.y1 * hres * px_size,
+                                (size_t)rows * hres * px_size,
+                                ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_INVALIDATE);
+#endif
+            }
+            if (job.swap) {
+                /* Pace the pipeline to the panel: at most one swap latches per
+                 * refresh, and waiting keeps every rendered frame on screen
+                 * exactly once, so animation cadence stays even — rendering
+                 * past the panel only produced dropped-frame judder. */
+#if (SOC_MIPI_DSI_SUPPORTED && ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 3, 0))
+                lvgl_port_recon_wait(ctx, 0, 0, 0xFFFFU, 0xFFFFU);
+#endif
+                uint32_t vsync_gap = 1;
+                const uint32_t frame_cost = ctx->mode_cost_ema[ctx->mode_best];
+                if (frame_cost > 52000U) {
+                    vsync_gap = 4;
+                } else if (frame_cost > 36000U) {
+                    vsync_gap = 3;
+                } else if (frame_cost > 20000U) {
+                    vsync_gap = 2;
+                }
+                const int64_t wait_start = esp_timer_get_time();
+                uint32_t waits = 0;
+                while (ctx->refresh_count - ctx->queued_refresh_count < vsync_gap && waits < 10U) {
+                    xSemaphoreTake(ctx->vsync_sem, pdMS_TO_TICKS(100));
+                    waits++;
+                }
+                ctx->last_swap_wait_us = (uint32_t)(esp_timer_get_time() - wait_start);
+                esp_lcd_panel_draw_bitmap(ctx->panel_handle, 0, 0, lv_disp_get_hor_res(job.drv),
+                                          lv_disp_get_ver_res(job.drv), fb);
+                ctx->queued_refresh_count = ctx->refresh_count;
+                ctx->active_fb = job.target;
+            }
+            lv_disp_flush_ready(job.drv);
+            __atomic_sub_fetch(&s_flush_pending, 1, __ATOMIC_SEQ_CST);
+            continue;
+        }
+        if (job.full) {
+            /* Triple-buffered full mode: the previously queued frame buffer must
+             * reach the scan-out (one vsync boundary) before the next switch is
+             * queued, or the panel would skip it and the ring would hand LVGL a
+             * buffer still being scanned. With renders slower than one refresh
+             * this never waits. */
+            while (job.ctx->refresh_count == job.ctx->queued_refresh_count) {
+                xSemaphoreTake(job.ctx->vsync_sem, portMAX_DELAY);
+            }
+            esp_lcd_panel_draw_bitmap(job.ctx->panel_handle, job.x1, job.y1, job.x2, job.y2, job.color_map);
+            job.ctx->queued_refresh_count = job.ctx->refresh_count;
+            if ((void *)job.color_map == job.ctx->panel_fbs[0]) {
+                job.ctx->active_fb = 0;
+            } else if ((void *)job.color_map == job.ctx->panel_fbs[1]) {
+                job.ctx->active_fb = 1;
+            } else if ((void *)job.color_map == job.ctx->panel_fbs[2]) {
+                job.ctx->active_fb = 2;
+            }
+            lv_disp_flush_ready(job.drv);
+            __atomic_sub_fetch(&s_flush_pending, 1, __ATOMIC_SEQ_CST);
+            continue;
+        }
+        esp_lcd_panel_draw_bitmap(job.ctx->panel_handle, job.x1, job.y1, job.x2, job.y2, job.color_map);
+        if (job.ctx->trans_sem) {
+            xSemaphoreTake(job.ctx->trans_sem, portMAX_DELAY);
+        }
+        lv_disp_flush_ready(job.drv);
+        __atomic_sub_fetch(&s_flush_pending, 1, __ATOMIC_SEQ_CST);
+    }
+}
+
+static bool lvgl_port_async_flush_start(void)
+{
+    if (s_flush_queue != NULL) {
+        return true;
+    }
+    s_flush_queue = xQueueCreate(4, sizeof(lvgl_port_flush_job_t));
+    if (s_flush_queue == NULL) {
+        return false;
+    }
+    if (xTaskCreatePinnedToCore(lvgl_port_flush_worker, "lvglFlush", 3072, NULL, 5, NULL, 0) != pdPASS) {
+        vQueueDelete(s_flush_queue);
+        s_flush_queue = NULL;
+        return false;
+    }
+    return true;
+}
+
+static void lvgl_port_async_flush_drain(void)
+{
+    if (s_flush_queue == NULL) {
+        return;
+    }
+    while (__atomic_load_n(&s_flush_pending, __ATOMIC_SEQ_CST) != 0) {
+        vTaskDelay(pdMS_TO_TICKS(1));
+    }
+}
