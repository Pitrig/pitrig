+typedef struct {
+    lv_display_t *drv;
+    lvgl_port_display_ctx_t *ctx;
+    uint16_t x1;
+    uint16_t y1;
+    uint16_t x2;
+    uint16_t y2;
+    uint8_t target;
+    uint8_t source;
+} lvgl_port_recon_item_t;
+
+static void lvgl_port_recon_worker(void *arg)
+{
+    lvgl_port_display_ctx_t *ctx = (lvgl_port_display_ctx_t *)arg;
+    lvgl_port_recon_item_t item;
+    for (;;) {
+        if (xQueueReceive(ctx->recon_queue, &item, portMAX_DELAY) != pdTRUE) {
+            continue;
+        }
+        const size_t hres = (size_t)lv_disp_get_hor_res(item.drv);
+        const uint32_t px_size = lv_color_format_get_size(lv_display_get_color_format(item.drv));
+        const uint32_t stride = (uint32_t)hres * px_size;
+        bool copied = false;
+        if (ctx->mcp_recon != NULL && item.x1 == 0U && (size_t)item.x2 == hres) {
+            uint8_t *dst_band = (uint8_t *)ctx->panel_fbs[item.target] + (size_t)item.y1 * stride;
+            uint8_t *src_band = (uint8_t *)ctx->panel_fbs[item.source] + (size_t)item.y1 * stride;
+            if (esp_async_memcpy(ctx->mcp_recon, dst_band, src_band,
+                                 (size_t)(item.y2 - item.y1) * stride,
+                                 lvgl_port_recon_mcp_done_callback, ctx) == ESP_OK) {
+                if (xSemaphoreTake(ctx->mcp_recon_done, pdMS_TO_TICKS(500)) == pdTRUE) {
+                    copied = true;
+                } else {
+                    /* A transfer that never completes would otherwise starve the
+                     * pipeline into the watchdog; retire the engine instead. */
+                    ctx->mcp_recon = NULL;
+                }
+            }
+        }
+        if (!copied) {
+            uint8_t *dst_fb = (uint8_t *)ctx->panel_fbs[item.target];
+            const uint8_t *src_fb = (const uint8_t *)ctx->panel_fbs[item.source];
+            const uint32_t row_offset = (uint32_t)item.x1 * px_size;
+            const uint32_t row_bytes = (uint32_t)(item.x2 - item.x1) * px_size;
+            for (uint16_t y = item.y1; y < item.y2; y++) {
+                memcpy(dst_fb + (uint32_t)y * stride + row_offset,
+                       src_fb + (uint32_t)y * stride + row_offset, row_bytes);
+            }
+            esp_cache_msync(dst_fb + (uint32_t)item.y1 * stride,
+                            (size_t)(item.y2 - item.y1) * stride,
+                            ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_INVALIDATE);
+        }
+        ctx->recon_completed = (uint8_t)(ctx->recon_completed + 1U);
+        xSemaphoreGive(ctx->recon_progress);
+    }
+}
+
+static void lvgl_port_recon_wait(lvgl_port_display_ctx_t *ctx, uint16_t x1, uint16_t y1,
+                                 uint16_t x2, uint16_t y2)
+{
+    uint8_t needed = ctx->recon_completed;
+    for (uint8_t rect = ctx->recon_completed; rect < ctx->recon_fired; rect++) {
+        if (x1 < ctx->recon_rects[rect][2] && x2 > ctx->recon_rects[rect][0]
+                && y1 < ctx->recon_rects[rect][3] && y2 > ctx->recon_rects[rect][1]) {
+            needed = (uint8_t)(rect + 1U);
+        }
+    }
+    while (ctx->recon_completed < needed) {
+        xSemaphoreTake(ctx->recon_progress, portMAX_DELAY);
+    }
+}
+#endif
