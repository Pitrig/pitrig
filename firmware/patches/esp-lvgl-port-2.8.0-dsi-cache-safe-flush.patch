+esp_err_t lvgl_port_disp_set_tear_free(lv_display_t *disp, bool tear_free)
+{
+    ESP_RETURN_ON_FALSE(disp != NULL, ESP_ERR_INVALID_ARG, TAG, "Display is NULL");
+    lvgl_port_display_ctx_t *disp_ctx = (lvgl_port_display_ctx_t *)lv_display_get_driver_data(disp);
+    ESP_RETURN_ON_FALSE(disp_ctx != NULL, ESP_ERR_INVALID_STATE, TAG, "Display context missing");
+    ESP_RETURN_ON_FALSE(disp_ctx->disp_type == LVGL_PORT_DISP_TYPE_RGB
+                        || disp_ctx->disp_type == LVGL_PORT_DISP_TYPE_DSI,
+                        ESP_ERR_NOT_SUPPORTED, TAG, "Only RGB and DSI panels can switch");
+    ESP_RETURN_ON_FALSE(disp_ctx->vsync_sem != NULL, ESP_ERR_INVALID_STATE, TAG, "No vsync semaphore");
+    if ((disp_ctx->flags.direct_mode != 0 || disp_ctx->flags.full_refresh != 0
+            || disp_ctx->flags.rgb_redirect != 0) == tear_free) {
+        return ESP_OK;
+    }
+    if (tear_free) {
+        void *fb0 = NULL;
+        void *fb1 = NULL;
+#if (SOC_LCDCAM_RGB_LCD_SUPPORTED && ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 0, 0))
+        if (disp_ctx->disp_type == LVGL_PORT_DISP_TYPE_RGB) {
+            ESP_RETURN_ON_ERROR(esp_lcd_rgb_panel_get_frame_buffer(disp_ctx->panel_handle, 2, &fb0, &fb1),
+                                TAG, "Get RGB frame buffers failed");
+        }
+#endif
+#if (SOC_MIPI_DSI_SUPPORTED && ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 3, 0))
+        if (disp_ctx->disp_type == LVGL_PORT_DISP_TYPE_DSI) {
+            ESP_RETURN_ON_ERROR(esp_lcd_dpi_panel_get_frame_buffer(disp_ctx->panel_handle, 2, &fb0, &fb1),
+                                TAG, "Get DSI frame buffers failed");
+        }
+#endif
+        ESP_RETURN_ON_FALSE(fb0 != NULL && fb1 != NULL, ESP_ERR_NOT_SUPPORTED, TAG,
+                            "Panel does not expose two frame buffers");
+        disp_ctx->panel_fbs[0] = fb0;
+        disp_ctx->panel_fbs[1] = fb1;
+        const uint32_t frame_bytes = (uint32_t)lv_display_get_horizontal_resolution(disp)
+                                     * (uint32_t)lv_display_get_vertical_resolution(disp)
+                                     * lv_color_format_get_size(lv_display_get_color_format(disp));
+        /* LVGL renders its first direct frame into the first buffer, and half
+         * the time that would be the buffer the panel is scanning out — a
+         * full-screen repaint painted in plain sight. Hand it the hidden one
+         * first; every later frame alternates cleanly behind the swap. */
+        void *hidden = (disp_ctx->active_fb == 0) ? fb1 : fb0;
+        void *shown = (disp_ctx->active_fb == 0) ? fb0 : fb1;
+        xSemaphoreTake(disp_ctx->vsync_sem, 0);
+        /* An RGB panel fed from PSRAM cannot afford rendering into the frame
+         * buffers at all on top of the scan-out stream: blending reads,
+         * modifies and writes PSRAM through the cache and the panel underruns
+         * — rows visibly slide down the screen. So RGB keeps LVGL in partial
+         * mode, with its cheap internal-RAM strips, and the flush redirects
+         * every strip into the hidden frame buffer instead of the shown one;
+         * the last strip of the frame swaps the buffers at the frame
+         * boundary. Same traffic as the resting state, tear-free like direct
+         * mode. DSI can afford true direct rendering and keeps it. */
+        if (disp_ctx->disp_type == LVGL_PORT_DISP_TYPE_RGB) {
+            (void)hidden;
+            (void)shown;
+            (void)frame_bytes;
+            disp_ctx->redirect_rows = 0;
+            disp_ctx->flags.rgb_redirect = 1;
+        } else {
+            disp_ctx->flags.direct_mode = 1;
+            lv_display_set_buffers(disp, hidden, shown, frame_bytes, LV_DISPLAY_RENDER_MODE_DIRECT);
+        }
+    } else {
+        if (disp_ctx->flags.direct_mode) {
+            ESP_RETURN_ON_FALSE(disp_ctx->draw_buffs[0] != NULL && disp_ctx->draw_buf_size_bytes > 0,
+                                ESP_ERR_INVALID_STATE, TAG, "No partial draw buffers to restore");
+            lv_display_set_buffers(disp, disp_ctx->draw_buffs[0], disp_ctx->draw_buffs[1],
+                                   disp_ctx->draw_buf_size_bytes, LV_DISPLAY_RENDER_MODE_PARTIAL);
+        }
+        disp_ctx->flags.direct_mode = 0;
+        disp_ctx->flags.full_refresh = 0;
+        disp_ctx->flags.rgb_redirect = 0;
+    }
+    lv_obj_invalidate(lv_display_get_screen_active(disp));
+    return ESP_OK;
+}
