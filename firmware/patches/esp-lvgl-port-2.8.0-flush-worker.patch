 } lvgl_port_display_ctx_t;
 
+typedef struct {
+    lv_display_t *drv;
+    lvgl_port_display_ctx_t *ctx;
+    const uint8_t *color_map;
+    int x1;
+    int y1;
+    int x2;
+    int y2;
+} lvgl_port_flush_job_t;
+
+static QueueHandle_t s_flush_queue = NULL;
+static volatile uint32_t s_flush_pending = 0;
+
+static void lvgl_port_flush_wait_cb(lv_display_t *disp)
+{
+    (void)disp;
+    uint32_t slept = 0;
+    while (__atomic_load_n(&s_flush_pending, __ATOMIC_SEQ_CST) > 0 && slept < 200U) {
+        vTaskDelay(1);
+        slept++;
+    }
+}
+
+static void lvgl_port_flush_worker(void *arg)
+{
+    lvgl_port_flush_job_t job;
+    (void)arg;
+    for (;;) {
+        if (xQueueReceive(s_flush_queue, &job, portMAX_DELAY) != pdTRUE) {
+            continue;
+        }
+        esp_lcd_panel_draw_bitmap(job.ctx->panel_handle, job.x1, job.y1, job.x2, job.y2, job.color_map);
+        if (job.ctx->trans_sem) {
+            xSemaphoreTake(job.ctx->trans_sem, portMAX_DELAY);
+        }
+        lv_disp_flush_ready(job.drv);
+        __atomic_sub_fetch(&s_flush_pending, 1, __ATOMIC_SEQ_CST);
+    }
+}
+
+static bool lvgl_port_async_flush_start(void)
+{
+    if (s_flush_queue != NULL) {
+        return true;
+    }
+    s_flush_queue = xQueueCreate(4, sizeof(lvgl_port_flush_job_t));
+    if (s_flush_queue == NULL) {
+        return false;
+    }
+    if (xTaskCreatePinnedToCore(lvgl_port_flush_worker, "lvglFlush", 3072, NULL, 5, NULL, 0) != pdPASS) {
+        vQueueDelete(s_flush_queue);
+        s_flush_queue = NULL;
+        return false;
+    }
+    return true;
+}
+
+static void lvgl_port_async_flush_drain(void)
+{
+    if (s_flush_queue == NULL) {
+        return;
+    }
+    while (__atomic_load_n(&s_flush_pending, __ATOMIC_SEQ_CST) != 0) {
+        vTaskDelay(pdMS_TO_TICKS(1));
+    }
+}
+
