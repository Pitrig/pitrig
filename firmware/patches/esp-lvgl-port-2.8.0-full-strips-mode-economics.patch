+static uint32_t lvgl_port_vsync_gap(uint32_t frame_cost)
+{
+    if (frame_cost > 52000U) {
+        return 4U;
+    }
+    if (frame_cost > 36000U) {
+        return 3U;
+    }
+    if (frame_cost > 20000U) {
+        return 2U;
+    }
+    return 1U;
+}
+
+static void lvgl_port_adaptive_refr_start_callback(lv_event_t *e)
+{
+    lvgl_port_display_ctx_t *disp_ctx = (lvgl_port_display_ctx_t *)lv_event_get_user_data(e);
+    lv_display_t *disp = disp_ctx->disp_drv;
+    disp_ctx->wait_accum_us = 0U;
+    uint8_t mode = disp_ctx->mode_best;
+    disp_ctx->probe_tick = (uint16_t)((disp_ctx->probe_tick + 1U) & 1023U);
+    if (!disp_ctx->mode_settled) {
+        disp_ctx->frame_full = mode;
+        disp_ctx->frame_t0 = esp_timer_get_time();
+        return;
+    }
+    const uint32_t best_cost = disp_ctx->mode_cost_ema[disp_ctx->mode_best];
+    const uint32_t other_cost = disp_ctx->mode_cost_ema[disp_ctx->mode_best ^ 1U];
+    const uint32_t budget = lvgl_port_vsync_gap(best_cost) * 16667U;
+    const uint8_t loser_bit = (uint8_t)(1U << (disp_ctx->mode_best ^ 1U));
+    const bool loser_unknown = (disp_ctx->mode_measured & loser_bit) == 0U;
+    const bool probe_unseen = other_cost + (other_cost >> 3) <= budget;
+    const uint16_t probe_mask = other_cost < best_cost + (best_cost >> 1) ? 127U : 1023U;
+    if (best_cost > 17500U && (loser_unknown || probe_unseen)
+            && (disp_ctx->probe_tick & probe_mask) < 4U) {
+        mode = disp_ctx->mode_best ^ 1U;
+    }
+    disp_ctx->frame_full = mode;
+    disp_ctx->frame_t0 = esp_timer_get_time();
+    if (mode != 0U) {
+        lv_obj_t *screen = lv_display_get_screen_active(disp);
+        if (screen != NULL) {
+            lv_obj_invalidate(screen);
+        }
+    }
+}
+
