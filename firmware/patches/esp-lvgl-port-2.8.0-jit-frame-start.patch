+static void lvgl_port_disp_jit_wait(void)
+{
+#ifdef CONFIG_PITRIG_DISPLAY_JIT
+    lvgl_port_display_ctx_t *ctx = s_strips_ctx;
+    if (ctx == NULL || !ctx->mode_settled) {
+        return;
+    }
+    const uint32_t period = ctx->vsync_period_us;
+    lvgl_port_jit_period_us = period;
+    if (period == 0U) {
+        return;
+    }
+    const uint32_t cost = ctx->mode_cost_ema[ctx->mode_best] + ctx->jit_margin_us;
+    if (cost + 1000U >= period) {
+        return;
+    }
+    const int64_t now = esp_timer_get_time();
+    int64_t next = ctx->last_vsync_us + (int64_t)period;
+    while (next <= now) {
+        next += (int64_t)period;
+    }
+    const int64_t start_by = next - (int64_t)cost;
+    if (start_by <= now + 1000) {
+        lvgl_port_jit_skipped++;
+    }
+    if (start_by > now + 1000) {
+        ctx->jit_slept = 1U;
+        lvgl_port_unlock();
+        vTaskDelay(pdMS_TO_TICKS((uint32_t)((start_by - now) / 1000)));
+        lvgl_port_lock(0);
+    }
+#endif
+}
