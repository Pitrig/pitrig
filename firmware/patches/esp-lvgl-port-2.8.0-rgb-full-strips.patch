+static void lvgl_port_rgb_sleep_until(lvgl_port_rgb_strips_t *rgb, int64_t until, bool on_line)
+{
+    const uint32_t line = s_pkt_last_line_lo32;
+    rgb->pacing = on_line ? 1U : 0U;
+    for (uint32_t naps = 0; naps < 4U; naps++) {
+        const int64_t left = until - esp_timer_get_time();
+        if (left < 100 || (on_line && s_pkt_last_line_lo32 != line)) {
+            break;
+        }
+        esp_timer_stop(rgb->alarm);
+        if (esp_timer_start_once(rgb->alarm, (uint64_t)left) != ESP_OK) {
+            break;
+        }
+        xSemaphoreTake(rgb->wake, pdMS_TO_TICKS(40));
+    }
+    rgb->pacing = 0U;
+}
+
+static int64_t lvgl_port_rgb_next_wrap(const lvgl_port_rgb_strips_t *rgb, int64_t now, uint32_t period)
+{
+    uint32_t ahead = rgb->wrap_lo32 + period - (uint32_t)now;
+    while ((int32_t)ahead <= 0) {
+        ahead += period;
+    }
+    return now + (int64_t)ahead;
+}
+
+static void lvgl_port_rgb_pace(lvgl_port_rgb_strips_t *rgb, int64_t now, uint32_t period)
+{
+    if ((int32_t)(s_pkt_last_line_lo32 - rgb->resumed_lo32) > 0) {
+        return;
+    }
+    const uint32_t lead = rgb->light ? rgb->cost_peak_us + rgb->margin_us : period - 200U;
+    if (rgb->serviced_lo32 != 0U) {
+        const int64_t start = now + (int32_t)(rgb->serviced_lo32 + period - lead - (uint32_t)now);
+        if (start > now + 500) {
+            lvgl_port_rgb_sleep_until(rgb, start, true);
+        }
+    }
+    const int64_t after = esp_timer_get_time();
+    const int64_t next = lvgl_port_rgb_next_wrap(rgb, after, period);
+    rgb->serviced_lo32 = (uint32_t)(next - (int64_t)lead <= after ? next : next - (int64_t)period) | 1U;
+}
+
+static void lvgl_port_rgb_hold(lvgl_port_display_ctx_t *ctx)
+{
+    lvgl_port_rgb_strips_t *rgb = ctx->rgb;
+    const bool idle = (uint32_t)esp_timer_get_time() - rgb->submit_lo32 > 250000U;
+    if (!rgb->light && !idle) {
+        return;
+    }
+    for (uint32_t naps = 0; naps < 4U; naps++) {
+        const uint32_t since = (uint32_t)esp_timer_get_time() - s_pkt_last_line_lo32;
+        if (s_pkt_last_line_lo32 == 0U || since >= LVGL_PORT_RGB_QUIET_US) {
+            break;
+        }
+        lvgl_port_rgb_sleep_until(rgb, esp_timer_get_time() + (int64_t)(LVGL_PORT_RGB_QUIET_US - since), false);
+    }
+    const uint32_t period = rgb->period_us;
+    if (period == 0U) {
+        return;
+    }
+    for (uint32_t naps = 0; naps < 4U && rgb->submitted - __atomic_load_n(&rgb->taken, __ATOMIC_SEQ_CST) > 1U; naps++) {
+        lvgl_port_rgb_sleep_until(rgb, lvgl_port_rgb_next_wrap(rgb, esp_timer_get_time(), period) + 200, false);
+    }
+    const int64_t now = esp_timer_get_time();
+    const uint32_t pending = rgb->submitted - __atomic_load_n(&rgb->taken, __ATOMIC_SEQ_CST);
+    if (pending == 0U) {
+        lvgl_port_rgb_pace(rgb, now, period);
+        rgb->resumed_lo32 = (uint32_t)esp_timer_get_time();
+        return;
+    }
+    rgb->resumed_lo32 = (uint32_t)now;
+    if (pending != 1U || !rgb->light) {
+        return;
+    }
+    int64_t latch = lvgl_port_rgb_next_wrap(rgb, now, period);
+    if (rgb->queued_frames == rgb->taken && latch - now < 1000) {
+        latch += (int64_t)period;
+    }
