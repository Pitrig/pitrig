+static void lvgl_port_rgb_note(uint16_t (*rects)[4], uint8_t *count, const uint16_t *rect)
+{
+    if (*count > 0U) {
+        uint16_t *last = rects[*count - 1U];
+        if (last[0] == rect[0] && last[2] == rect[2] && last[3] == rect[1]) {
+            last[3] = rect[3];
+            return;
+        }
+    }
+    if (*count < LVGL_PORT_RGB_RECTS) {
+        memcpy(rects[*count], rect, sizeof(rects[0]));
+        *count = (uint8_t)(*count + 1U);
+        return;
+    }
+    uint16_t *box = rects[LVGL_PORT_RGB_RECTS - 1U];
+    box[0] = LV_MIN(box[0], rect[0]);
+    box[1] = LV_MIN(box[1], rect[1]);
+    box[2] = LV_MAX(box[2], rect[2]);
+    box[3] = LV_MAX(box[3], rect[3]);
+}
+
+static void lvgl_port_rgb_copy(uint8_t *dst_fb, const uint8_t *src, uint32_t src_stride,
+                               uint32_t stride, uint32_t px_size, const uint16_t *rect)
+{
+    const uint32_t row_bytes = (uint32_t)(rect[2] - rect[0]) * px_size;
+    uint8_t *dst = dst_fb + (uint32_t)rect[1] * stride + (uint32_t)rect[0] * px_size;
+    if (row_bytes == stride && src_stride == stride) {
+        memcpy(dst, src, (size_t)row_bytes * (uint32_t)(rect[3] - rect[1]));
+        return;
+    }
+    for (uint16_t y = rect[1]; y < rect[3]; y++) {
+        memcpy(dst, src, row_bytes);
+        dst += stride;
+        src += src_stride;
+    }
+}
+
+static bool lvgl_port_rgb_recon_step(lvgl_port_display_ctx_t *ctx, uint32_t stride, uint32_t px_size,
+                                     uint32_t budget_rows)
+{
+    lvgl_port_rgb_strips_t *rgb = ctx->rgb;
+    uint8_t *target_fb = (uint8_t *)ctx->panel_fbs[rgb->target];
+    const uint8_t *source_fb = (const uint8_t *)ctx->panel_fbs[rgb->newest];
+    const uint8_t areas = rgb->trust ? rgb->frame_area_count : 0U;
+    while (rgb->recon_pending) {
+        if (rgb->recon_depth == 0U) {
+            while (rgb->recon_frame + 1U < rgb->buffers
+                    && rgb->recon_stale >= rgb->history_count[rgb->recon_frame]) {
+                rgb->recon_frame++;
+                rgb->recon_stale = 0;
+            }
+            if (rgb->recon_frame + 1U >= rgb->buffers) {
+                rgb->recon_pending = 0;
+                return false;
+            }
+            memcpy(rgb->pieces[0], rgb->history[rgb->recon_frame][rgb->recon_stale], sizeof(rgb->history[0][0]));
+            rgb->pieces[0][4] = 0;
+            rgb->recon_depth = 1;
+            rgb->recon_stale++;
+        }
+        rgb->recon_depth--;
+        uint16_t *piece = rgb->pieces[rgb->recon_depth];
+        const uint16_t x1 = piece[0];
+        const uint16_t y1 = piece[1];
+        const uint16_t x2 = piece[2];
+        const uint16_t y2 = piece[3];
+        uint8_t next = (uint8_t)piece[4];
+        while (next < areas) {
+            const uint16_t *area = rgb->frame_areas[next];
+            if (x1 < area[2] && area[0] < x2 && y1 < area[3] && area[1] < y2) {
+                break;
+            }
+            next++;
+        }
+        if (next >= areas) {
+            const uint16_t rows = (uint16_t)LV_MIN((uint32_t)(y2 - y1), budget_rows);
+            const uint16_t rect[4] = {x1, y1, x2, (uint16_t)(y1 + rows)};
+            lvgl_port_rgb_copy(target_fb, source_fb + (uint32_t)y1 * stride + (uint32_t)x1 * px_size,
+                               stride, stride, px_size, rect);
+            if (rect[3] < y2) {
+                piece[1] = rect[3];
+                piece[4] = areas;
+                rgb->recon_depth++;
+            }
+            if (budget_rows <= rows) {
+                return rgb->recon_pending;
+            }
+            budget_rows -= rows;
+            continue;
+        }
+        const uint16_t *area = rgb->frame_areas[next];
+        const uint16_t band_y1 = LV_MAX(y1, area[1]);
+        const uint16_t band_y2 = LV_MIN(y2, area[3]);
+        const uint16_t parts[4][4] = {
+            {x1, y1, x2, band_y1},
+            {x1, band_y2, x2, y2},
+            {x1, band_y1, LV_MAX(x1, area[0]), band_y2},
+            {LV_MIN(x2, area[2]), band_y1, x2, band_y2},
+        };
+        for (uint8_t part = 0; part < 4U; part++) {
+            const uint16_t *rect = parts[part];
+            if (rect[0] >= rect[2] || rect[1] >= rect[3]) {
+                continue;
+            }
+            if (rgb->recon_depth < LVGL_PORT_RGB_PIECES) {
+                memcpy(rgb->pieces[rgb->recon_depth], rect, sizeof(parts[0]));
+                rgb->pieces[rgb->recon_depth][4] = (uint16_t)(next + 1U);
+                rgb->recon_depth++;
+            } else {
+                rgb->heal = 1;
+            }
+        }
+    }
+    return false;
+}
+
+static bool lvgl_port_rgb_latched(lvgl_port_display_ctx_t *ctx)
+{
+    lvgl_port_rgb_strips_t *rgb = ctx->rgb;
+    if (rgb->queued < rgb->buffers && ctx->refresh_count != rgb->queued_seen) {
+        ctx->active_fb = rgb->queued;
+        rgb->queued = UINT8_MAX;
+    }
+    return rgb->queued >= rgb->buffers;
+}
+
+static void lvgl_port_rgb_wait_latch(lvgl_port_display_ctx_t *ctx)
+{
+    for (uint32_t waits = 0; !lvgl_port_rgb_latched(ctx) && waits < 8U; waits++) {
+        xSemaphoreTake(ctx->vsync_sem, pdMS_TO_TICKS(50));
+    }
+    if (ctx->rgb->queued < ctx->rgb->buffers) {
+        ctx->active_fb = ctx->rgb->queued;
+        ctx->rgb->queued = UINT8_MAX;
+    }
+}
+
+static void lvgl_port_rgb_rate(lvgl_port_rgb_strips_t *rgb, const lvgl_port_flush_job_t *job,
+                               int64_t wait_from, int64_t wait_to)
+{
+    int64_t paced = wait_to - wait_from;
+    const int64_t earlier_from = LV_MAX(rgb->wait_from_us, job->started_us);
+    if (rgb->wait_to_us > earlier_from) {
+        paced += rgb->wait_to_us - earlier_from;
+    }
+    rgb->wait_from_us = wait_from;
+    rgb->wait_to_us = wait_to;
+    const int64_t done_us = esp_timer_get_time();
+    const int64_t span = done_us - job->started_us - paced;
+    const uint32_t cost = span > 0 ? (uint32_t)LV_MIN(span, (int64_t)1000000) : 0U;
+    const uint32_t target = rgb->target_lo32;
+    if (target != 0U) {
+        if ((int32_t)((uint32_t)done_us + 100U - target) >= 0) {
+            rgb->margin_us = LV_MIN(rgb->margin_us + 500U, 5000U);
+            rgb->hits = 0;
+        } else if (++rgb->hits >= 64U) {
+            rgb->margin_us = LV_MAX(rgb->margin_us - 250U, 1000U);
+            rgb->hits = 0;
+        }
+        rgb->target_lo32 = 0U;
+    }
+    const uint32_t peak = rgb->cost_peak_us - (rgb->cost_peak_us >> 5);
+    rgb->cost_peak_us = LV_MAX(cost, peak);
+    const uint32_t period = rgb->period_us;
+    const uint32_t needed = rgb->cost_peak_us + rgb->margin_us;
+    if (period == 0U || needed + 1500U >= period) {
+        rgb->light = 0;
+        rgb->calm = 0;
+    } else if (needed + 3000U >= period) {
+        rgb->calm = 0;
+    } else if (++rgb->calm >= 60U) {
+        rgb->calm = 60U;
+        rgb->light = 1;
+    }
+    const uint32_t least = rgb->cost_least_us;
+    rgb->cost_least_us = least == 0U || cost < least ? cost : least + ((cost - least) >> 4);
+}
+
+static void lvgl_port_rgb_strip(const lvgl_port_flush_job_t *job)
+{
+    lvgl_port_display_ctx_t *ctx = job->ctx;
+    lvgl_port_rgb_strips_t *rgb = ctx->rgb;
+    const uint32_t px_size = lv_color_format_get_size(lv_display_get_color_format(job->drv));
+    const uint32_t hres = (uint32_t)lv_disp_get_hor_res(job->drv);
+    const uint32_t stride = hres * px_size;
+    if (!rgb->open) {
+        rgb->target = (uint8_t)((rgb->newest + 1U) % rgb->buffers);
+        if (rgb->target == ctx->active_fb) {
+            lvgl_port_rgb_wait_latch(ctx);
+        } else {
+            (void)lvgl_port_rgb_latched(ctx);
+        }
+        rgb->frame_area_count = rgb->area_exact[job->source] ? rgb->area_count[job->source] : 0U;
+        rgb->frame_area_px = rgb->area_px[job->source];
+        memcpy(rgb->frame_areas, rgb->areas[job->source], sizeof(rgb->frame_areas[0]) * rgb->frame_area_count);
+        rgb->recon_frame = 0;
+        rgb->recon_stale = 0;
+        rgb->recon_depth = 0;
+        rgb->recon_pending = 1;
+        if (!rgb->trust || rgb->frame_area_count == 0U) {
+            (void)lvgl_port_rgb_recon_step(ctx, stride, px_size, UINT32_MAX);
+        }
+        rgb->open = 1;
+        rgb->drawn_count = 0;
+        rgb->drawn_px = 0;
+    }
+    const uint16_t rect[4] = {(uint16_t)job->x1, (uint16_t)job->y1, (uint16_t)job->x2, (uint16_t)job->y2};
+    lvgl_port_rgb_copy((uint8_t *)ctx->panel_fbs[rgb->target], job->color_map,
+                       (uint32_t)(job->x2 - job->x1) * px_size, stride, px_size, rect);
+    lvgl_port_rgb_note(rgb->drawn, &rgb->drawn_count, rect);
+    rgb->drawn_px += (uint32_t)(job->x2 - job->x1) * (uint32_t)(job->y2 - job->y1);
+    lv_disp_flush_ready(job->drv);
+    if (!job->swap) {
+        return;
+    }
+    (void)lvgl_port_rgb_recon_step(ctx, stride, px_size, UINT32_MAX);
+    if (rgb->trust && rgb->drawn_px != rgb->frame_area_px) {
+        rgb->trust = 0;
+        rgb->heal = 1;
+    }
+    memcpy(rgb->history[1], rgb->history[0], sizeof(rgb->history[0][0]) * rgb->history_count[0]);
+    rgb->history_count[1] = rgb->history_count[0];
+    memcpy(rgb->history[0], rgb->drawn, sizeof(rgb->drawn[0]) * rgb->drawn_count);
+    rgb->history_count[0] = rgb->drawn_count;
+    const int64_t wait_from = esp_timer_get_time();
+    lvgl_port_rgb_wait_latch(ctx);
+    const int64_t wait_to = esp_timer_get_time();
+    esp_lcd_panel_draw_bitmap(ctx->panel_handle, 0, 0, (int)hres, lv_disp_get_ver_res(job->drv),
+                              ctx->panel_fbs[rgb->target]);
+    rgb->queued_seen = ctx->refresh_count;
+    __atomic_store_n(&rgb->queued_frames, rgb->queued_frames + 1U, __ATOMIC_SEQ_CST);
+    lvgl_port_rgb_rate(rgb, job, wait_from, wait_to);
+    rgb->queued = rgb->target;
+    rgb->newest = rgb->target;
+    rgb->open = 0;
+    lvgl_port_acc_swaps++;
+}
+
+static void lvgl_port_rgb_flush_wait_cb(lv_display_t *disp)
+{
+    lvgl_port_display_ctx_t *ctx = (lvgl_port_display_ctx_t *)lv_display_get_driver_data(disp);
+    for (uint32_t waits = 0; __atomic_load_n(&s_flush_pending, __ATOMIC_SEQ_CST) > 0 && waits < 20U; waits++) {
+        xSemaphoreTake(ctx->rgb->done, pdMS_TO_TICKS(10));
+    }
+}
