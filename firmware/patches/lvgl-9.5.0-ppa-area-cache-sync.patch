diff --git a/firmware/managed_components/lvgl__lvgl/src/draw/espressif/ppa/lv_draw_ppa_buf.c b/firmware/managed_components/lvgl__lvgl/src/draw/espressif/ppa/lv_draw_ppa_buf.c
index 049bf6b..85e4b84 100644
--- a/firmware/managed_components/lvgl__lvgl/src/draw/espressif/ppa/lv_draw_ppa_buf.c
+++ b/firmware/managed_components/lvgl__lvgl/src/draw/espressif/ppa/lv_draw_ppa_buf.c
@@ -41,6 +41,32 @@ void lv_draw_buf_ppa_init_handlers(void)
 
 static void invalidate_cache(const lv_draw_buf_t * draw_buf, const lv_area_t * area)
 {
-    esp_cache_msync(draw_buf->data, draw_buf->data_size, ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_TYPE_DATA);
+    /* Write back dirty lines so PPA output is not overwritten by a later
+     * eviction, and drop them so the CPU reads PPA output afterwards. */
+    const int flags = ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_INVALIDATE |
+                      ESP_CACHE_MSYNC_FLAG_TYPE_DATA;
+
+    if(area == NULL) {
+        esp_cache_msync(draw_buf->data, draw_buf->data_size, flags);
+        return;
+    }
+
+    /* Only the rows the operation touches need synchronizing. `area` is in
+     * buffer coordinates. Whole rows are used because the cache-line contract
+     * is easier to satisfy on row boundaries than on arbitrary columns. */
+    int32_t y1 = LV_MAX(area->y1, 0);
+    int32_t y2 = LV_MIN(area->y2, (int32_t)draw_buf->header.h - 1);
+    if(y1 > y2) return;
+
+    /* Rounding out to whole cache lines can touch at most one line beyond the
+     * rows, which a write-back-and-invalidate leaves intact. */
+    const uint32_t stride = draw_buf->header.stride;
+    const uintptr_t line = CONFIG_CACHE_L2_CACHE_LINE_SIZE;
+    uintptr_t start = (uintptr_t)draw_buf->data + (uintptr_t)y1 * stride;
+    uintptr_t end = (uintptr_t)draw_buf->data + (uintptr_t)(y2 + 1) * stride;
+    start &= ~(line - 1);
+    end = (end + line - 1) & ~(line - 1);
+
+    esp_cache_msync((void *)start, end - start, flags);
 }
 #endif /* LV_USE_PPA */
