+typedef struct {
+    const lv_opa_t * opa;
+    int32_t lo;
+    int32_t hi;
+    int32_t cxl;
+    int32_t cxr;
+    int32_t aa;
+    uint8_t kind;
+} radius_row_t;
+
+static int32_t radius_row_init(const lv_draw_sw_mask_radius_row_mask_t * m, int32_t abs_x, int32_t len,
+                               int32_t abs_y, radius_row_t * r)
+{
+    const lv_draw_sw_mask_radius_param_t * p = m->param;
+    const lv_area_t * rect = &p->cfg.rect;
+    int32_t radius = p->cfg.radius;
+    r->kind = 0;
+    if(abs_y < rect->y1 || abs_y > rect->y2) return p->cfg.outer ? 1 : 0;
+    if((abs_x >= rect->x1 + radius && abs_x + len <= rect->x2 - radius) ||
+       (abs_y >= rect->y1 + radius && abs_y <= rect->y2 - radius)) {
+        r->kind = p->cfg.outer ? 2 : 1;
+        r->lo = rect->x1;
+        r->hi = rect->x2;
+        return 1;
+    }
+    int32_t y = abs_y - rect->y1;
+    int32_t x_start;
+    r->opa = get_next_line(p->circle, y < radius ? radius - y - 1 : y - (m->height - radius), &r->aa, &x_start);
+    r->cxl = rect->x1 + radius - x_start - 1;
+    r->cxr = rect->x1 + m->width - radius + x_start;
+    if(r->cxr <= r->cxl) return -1;
+    r->kind = p->cfg.outer ? 4 : 3;
+    return 1;
+}
+
+static inline int32_t radius_row_state(const radius_row_t * r, int32_t x)
+{
+    switch(r->kind) {
+        case 1:
+            return x < r->lo || x > r->hi ? 0 : 1;
+        case 2:
+            return x >= r->lo && x <= r->hi ? 0 : 1;
+        case 3:
+            if(x <= r->cxl - r->aa || x >= r->cxr + r->aa) return 0;
+            return x <= r->cxl || x >= r->cxr ? 2 : 1;
+        case 4:
+            if(x <= r->cxl - r->aa || x >= r->cxr + r->aa) return 1;
+            return x <= r->cxl || x >= r->cxr ? 2 : 0;
+        default:
+            return 1;
+    }
+}
+
+static inline lv_opa_t radius_row_aa(const radius_row_t * r, int32_t x)
+{
+    lv_opa_t v = x <= r->cxl ? r->opa[r->aa - 1 - (r->cxl - x)] : r->opa[r->aa - 1 - (x - r->cxr)];
+    return r->kind == 4 ? (lv_opa_t)(255 - v) : v;
+}
+
+static inline uint16_t radius_row_mix(uint16_t c1, uint16_t c2, uint8_t mix)
+{
+    if(mix == 255) return c1;
+    if(mix == 0) return c2;
+    if(c1 == c2) return c1;
+    mix = (uint32_t)((uint32_t)mix + 4) >> 3;
+    uint32_t bg = (uint32_t)(c2 | ((uint32_t)c2 << 16)) & 0x7E0F81F;
+    uint32_t fg = (uint32_t)(c1 | ((uint32_t)c1 << 16)) & 0x7E0F81F;
+    uint32_t result = ((((fg - bg) * mix) >> 5) + bg) & 0x7E0F81F;
+    return (uint16_t)(result >> 16) | result;
+}
+
+static void radius_row_breaks(const radius_row_t * r, int32_t * breaks, int32_t * count, int32_t first, int32_t end)
+{
+    int32_t points[4];
+    int32_t n = 0;
+    if(r->kind == 1 || r->kind == 2) {
+        points[n++] = r->lo;
+        points[n++] = r->hi + 1;
+    }
+    else if(r->kind == 3 || r->kind == 4) {
+        points[n++] = r->cxl - r->aa + 1;
+        points[n++] = r->cxl + 1;
+        points[n++] = r->cxr;
+        points[n++] = r->cxr + r->aa;
+    }
+    int32_t i;
+    for(i = 0; i < n; i++) {
+        if(points[i] <= first || points[i] >= end) continue;
+        int32_t j = *count;
+        while(j > 0 && breaks[j - 1] > points[i]) {
+            breaks[j] = breaks[j - 1];
+            j--;
+        }
+        breaks[j] = points[i];
+        (*count)++;
+    }
+}
+
+static void radius_row_segments(const radius_row_t * rows, int32_t n, int32_t first, int32_t end, uint16_t * row,
+                                lv_opa_t start_opa, uint16_t color16)
+{
+    int32_t breaks[4 * LV_DRAW_SW_MASK_RADIUS_ROW_MAX + 2];
+    int32_t count = 1;
+    breaks[0] = first;
+    int32_t i;
+    for(i = 0; i < n; i++) radius_row_breaks(&rows[i], breaks, &count, first, end);
+    breaks[count++] = end;
+    int32_t s;
+    for(s = 0; s + 1 < count; s++) {
+        int32_t a = breaks[s];
+        int32_t b = breaks[s + 1];
+        if(a >= b) continue;
+        uint8_t aa_rows[LV_DRAW_SW_MASK_RADIUS_ROW_MAX];
+        int32_t aa_count = 0;
+        bool zero = false;
+        for(i = 0; i < n; i++) {
+            int32_t state = radius_row_state(&rows[i], a);
+            if(state == 0) {
+                zero = true;
+                break;
+            }
+            if(state == 2) aa_rows[aa_count++] = (uint8_t)i;
+        }
+        if(zero) continue;
+        uint16_t * d = row + (a - first);
+        int32_t x;
+        for(x = a; x < b; x++, d++) {
+            lv_opa_t v = start_opa;
+            int32_t k;
+            for(k = 0; k < aa_count; k++) v = mask_mix(radius_row_aa(&rows[aa_rows[k]], x), v);
+            *d = radius_row_mix(color16, *d, v);
+        }
+    }
+}
+
+static void radius_row_ring(const radius_row_t * keep, const radius_row_t * cut, int32_t first, int32_t end,
+                            uint16_t * row, uint16_t color16)
+{
+    int32_t starts[6];
+    int32_t ends[6];
+    const lv_opa_t * srcs[6];
+    int32_t steps[6];
+    lv_opa_t flips[6];
+    int32_t n = 0;
+    starts[n] = keep->cxl - keep->aa + 1;
+    ends[n] = keep->cxl + 1;
+    srcs[n] = keep->opa;
+    steps[n] = 1;
+    flips[n++] = 0;
+    if(cut == NULL) {
+        starts[n] = keep->cxl + 1;
+        ends[n] = keep->cxr;
+        srcs[n++] = NULL;
+    }
+    else {
+        starts[n] = keep->cxl + 1;
+        ends[n] = cut->cxl - cut->aa + 1;
+        srcs[n++] = NULL;
+        starts[n] = cut->cxl - cut->aa + 1;
+        ends[n] = cut->cxl + 1;
+        srcs[n] = cut->opa;
+        steps[n] = 1;
+        flips[n++] = 255;
+        starts[n] = cut->cxr;
+        ends[n] = cut->cxr + cut->aa;
+        srcs[n] = cut->opa + cut->aa - 1;
+        steps[n] = -1;
+        flips[n++] = 255;
+        starts[n] = cut->cxr + cut->aa;
+        ends[n] = keep->cxr;
+        srcs[n++] = NULL;
+    }
+    starts[n] = keep->cxr;
+    ends[n] = keep->cxr + keep->aa;
+    srcs[n] = keep->opa + keep->aa - 1;
+    steps[n] = -1;
+    flips[n++] = 0;
+    uint32_t c32 = (uint32_t)color16 | ((uint32_t)color16 << 16);
+    int32_t k;
+    for(k = 0; k < n; k++) {
+        int32_t a = LV_MAX(starts[k], first);
+        int32_t b = LV_MIN(ends[k], end);
+        if(a >= b) continue;
+        uint16_t * d = row + (a - first);
+        if(srcs[k] == NULL) {
+            int32_t count = b - a;
+            if((lv_uintptr_t)d & 0x2) {
+                *d++ = color16;
+                count--;
+            }
+            uint32_t * d32 = (uint32_t *)d;
+            for(; count >= 2; count -= 2) *d32++ = c32;
+            if(count) *(uint16_t *)d32 = color16;
+        }
+        else {
+            const lv_opa_t * src = srcs[k] + (a - starts[k]) * steps[k];
+            int32_t step = steps[k];
+            lv_opa_t flip = flips[k];
+            for(; a < b; a++, d++, src += step) *d = radius_row_mix(color16, *d, (lv_opa_t)(*src ^ flip));
+        }
+    }
+}
+
+bool lv_draw_sw_mask_radius_rows_init(lv_draw_sw_mask_radius_rows_t * rows, lv_draw_task_t * t, void * masks[],
+                                      lv_opa_t start_opa, lv_color_t color)
+{
+#if LV_USE_DRAW_SW_ASM == LV_DRAW_SW_ASM_NONE
+    lv_layer_t * layer = t->target_layer;
+    if(layer == NULL || layer->draw_buf == NULL || layer->color_format != LV_COLOR_FORMAT_RGB565 ||
+       layer->draw_buf->header.cf != LV_COLOR_FORMAT_RGB565) return false;
+    if(lv_draw_sw_get_blend_handler(layer->color_format) != NULL) return false;
+    int32_t n;
+    for(n = 0; masks[n]; n++) {
+        const lv_draw_sw_mask_radius_param_t * p = masks[n];
+        if(n >= LV_DRAW_SW_MASK_RADIUS_ROW_MAX || p->dsc.type != LV_DRAW_SW_MASK_TYPE_RADIUS) return false;
+        rows->masks[n].param = p;
+        rows->masks[n].width = lv_area_get_width(&p->cfg.rect);
+        rows->masks[n].height = lv_area_get_height(&p->cfg.rect);
+    }
+    if(n == 0) return false;
+    rows->count = n;
+    rows->buf = layer->draw_buf->data;
+    rows->stride = (int32_t)layer->draw_buf->header.stride;
+    rows->buf_area = layer->buf_area;
+    rows->clip_area = t->clip_area;
+    rows->color16 = lv_color_to_u16(color);
+    rows->start_opa = start_opa;
+    return true;
+#else
+    LV_UNUSED(rows);
+    LV_UNUSED(t);
+    LV_UNUSED(masks);
+    LV_UNUSED(start_opa);
+    LV_UNUSED(color);
+    return false;
+#endif
+}
+
+bool lv_draw_sw_mask_radius_rows_blend(const lv_draw_sw_mask_radius_rows_t * rows, int32_t abs_x, int32_t len,
+                                       int32_t mask_y, int32_t dest_y1, int32_t dest_y2)
+{
+    radius_row_t r[LV_DRAW_SW_MASK_RADIUS_ROW_MAX];
+    const radius_row_t * keep = NULL;
+    const radius_row_t * cut = NULL;
+    bool ring = rows->start_opa == LV_OPA_COVER;
+    int32_t i;
+    for(i = 0; i < rows->count; i++) {
+        int32_t res = radius_row_init(&rows->masks[i], abs_x, len, mask_y, &r[i]);
+        if(res < 0) return false;
+        if(res == 0) return true;
+        if(r[i].kind == 3 && keep == NULL) keep = &r[i];
+        else if(r[i].kind == 4 && cut == NULL) cut = &r[i];
+        else if(r[i].kind != 0) ring = false;
+    }
+    if(keep == NULL) ring = false;
+    if(ring && cut != NULL &&
+       (cut->cxl - cut->aa + 1 <= keep->cxl || cut->cxr + cut->aa - 1 >= keep->cxr)) ring = false;
+
+    int32_t first = LV_MAX(abs_x, rows->clip_area.x1);
+    int32_t end = LV_MIN(abs_x + len, rows->clip_area.x2 + 1);
+    if(ring) {
+        first = LV_MAX(first, keep->cxl - keep->aa + 1);
+        end = LV_MIN(end, keep->cxr + keep->aa);
+        if(cut != NULL && first > cut->cxl && end <= cut->cxr) return true;
+    }
+    if(first >= end) return true;
+
+    int32_t dests[2] = {dest_y1, dest_y2};
+    for(i = 0; i < 2; i++) {
+        int32_t y = dests[i];
+        if(y == LV_DRAW_SW_MASK_NO_ROW || y < rows->clip_area.y1 || y > rows->clip_area.y2) continue;
+        uint16_t * row = (uint16_t *)(rows->buf + rows->stride * (y - rows->buf_area.y1)) +
+                         (first - rows->buf_area.x1);
+        if(ring) radius_row_ring(keep, cut, first, end, row, rows->color16);
+        else radius_row_segments(r, rows->count, first, end, row, rows->start_opa, rows->color16);
+    }
+    return true;
+}
+
+bool lv_draw_sw_mask_is_cover(const lv_opa_t * mask_buf, int32_t len)
+{
+    int32_t i = 0;
+    for(; i < len && ((lv_uintptr_t)&mask_buf[i] & 0x3); i++) {
+        if(mask_buf[i] != LV_OPA_COVER) return false;
+    }
+    for(; i + 4 <= len; i += 4) {
+        if(*(const uint32_t *)&mask_buf[i] != 0xFFFFFFFFU) return false;
+    }
+    for(; i < len; i++) {
+        if(mask_buf[i] != LV_OPA_COVER) return false;
+    }
+    return true;
+}
