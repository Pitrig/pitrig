CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
# CONFIG_LV_FONT_MONTSERRAT_14 is not set
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_VECTOR_GRAPHIC=n
CONFIG_LV_USE_THORVG=n
# CONFIG_LV_USE_FLOAT is not set
# Dashboard fonts are uploaded TTF/OTF faces rasterized on the device. File
# support stays off on purpose: it switches the parser to a stream whose read
# position is shared state, which is unsafe once more than one draw unit runs.
CONFIG_LV_USE_TINY_TTF=y
# CONFIG_LV_TINY_TTF_FILE_SUPPORT is not set
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=128
# Fonts are created without kerning, so the kerning cache would only hold
# single-glyph entries; zero selects the direct path that allocates nothing.
CONFIG_LV_TINY_TTF_CACHE_KERNING_CNT=0
CONFIG_LV_DEF_REFR_PERIOD=8
CONFIG_FREERTOS_HZ=1000
# Keep the UART receive interrupt running while flash is written so telemetry
# is buffered, not lost, during a configuration save on UART-transport boards.
CONFIG_UART_ISR_IN_IRAM=y
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS is not set
CONFIG_LV_USE_SYSMON=n
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="SimCore"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="SimCore"
CONFIG_TINYUSB_DESC_CDC_STRING="SimCore CDC"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_CJSON_NESTING_LIMIT=16
# CONFIG_SIMCORE_DEBUG is not set
# CONFIG_SIMCORE_LAYOUT_DEBUG is not set
