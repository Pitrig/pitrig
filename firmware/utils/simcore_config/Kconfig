menu "SimCore"

config SIMCORE_DEBUG
    bool "Runtime performance diagnostics"
    default n
    select FREERTOS_GENERATE_RUN_TIME_STATS
    help
        Enables performance collection, transport diagnostics, and the
        on-screen performance overlay.

config SIMCORE_LOG_MODE_FULL
    bool "Formatted, level-aware log forwarding"
    default n
    help
        Selects the full ESP-IDF logging mode inside the logger instead of the
        simple one. The public logging API is identical either way; only which
        backend call the logger makes changes. See ADR 0001.

config SIMCORE_LAYOUT_DEBUG
    bool "Dashboard layout outlines"
    default n
    help
        Draws dashboard block and widget boundaries.

choice SIMCORE_FACTORY_BOARD
    prompt "Factory board profile"
    default SIMCORE_FACTORY_BOARD_GUITION_JC1060P470C if IDF_TARGET_ESP32P4
    default SIMCORE_FACTORY_BOARD_T_DISPLAY_S3
    help
        Selects the immutable hardware identity and the fallback configuration
        used when neither NVS configuration slot is valid. A build links only
        the board drivers its target can carry, so the P4 offers one board and
        the ESP32-S3 keeps both of its alternatives discoverable — ESP-IDF
        resolves component requirements before loading this choice on a fresh
        configure.

config SIMCORE_FACTORY_BOARD_T_DISPLAY_S3
    bool "LilyGO T-Display-S3"
    depends on IDF_TARGET_ESP32S3

config SIMCORE_FACTORY_BOARD_GUITION_ESP32_4848S040
    bool "Guition ESP32-4848S040"
    depends on IDF_TARGET_ESP32S3

config SIMCORE_FACTORY_BOARD_GUITION_JC1060P470C
    bool "Guition JC1060P470C"
    depends on IDF_TARGET_ESP32P4

endchoice

config SIMCORE_SECOND_TELEMETRY_LINK
    bool "Second telemetry link on the USB-Serial-JTAG port"
    depends on SIMCORE_FACTORY_BOARD_GUITION_JC1060P470C
    default n
    help
        Development aid, not a product feature. Runs telemetry, the @SC:
        control protocol, and asset upload on the USB-Serial-JTAG port in
        addition to the native USB CDC port, so a host can be attached to
        either one. Flashing over that port is unaffected: download mode is
        entered by the peripheral, not by the application.

        The device configuration knows nothing about this. Leaving the option
        off compiles the second link out entirely.

config SIMCORE_SECOND_TELEMETRY_LINK_SILENCE_LOGS
    bool "Silence ESP logs while the second link runs"
    depends on SIMCORE_SECOND_TELEMETRY_LINK
    default y
    help
        The USB-Serial-JTAG port is also the secondary console, so log lines
        would interleave with telemetry and control replies on it. Silencing
        is global, so the primary UART console goes quiet as well; turn this
        off when reading logs matters more than a clean second stream.

endmenu
