    "transmission.gear": { "property": "DataCorePlugin.GameData.NewData.Gear", "conversion": "text", "fallback": "N" },
    "transmission.gear_number": { "property": "DataCorePlugin.GameData.NewData.Gear", "format": "0" },
    "transmission.shifting": { "property": "DataCorePlugin.GameData.NewData.IsShifting", "conversion": "boolean" },
    "transmission.damage": { "property": "DataCorePlugin.GameData.NewData.TransmissionDamage", "format": "0.###" },
