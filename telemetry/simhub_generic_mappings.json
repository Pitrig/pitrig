    "session.sector.1_time": { "property": "DataCorePlugin.GameData.NewData.CurrentLapSector1Time", "conversion": "timespan_ms" },
    "session.sector.2_time": { "property": "DataCorePlugin.GameData.NewData.CurrentLapSector2Time", "conversion": "timespan_ms" },
    "session.sector.3_time": { "property": "DataCorePlugin.GameData.NewData.CurrentLapSector3Time", "conversion": "timespan_ms" },
    "session.sector.1_best": { "property": "DataCorePlugin.GameData.NewData.BestSector1Time", "conversion": "timespan_ms" },
