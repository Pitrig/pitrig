    "session.lap.best_time": { "property": "DataCorePlugin.GameData.NewData.BestLapTime", "conversion": "timespan_ms" },
    "session.lap.session_best_time": { "property": "DataCorePlugin.GameData.NewData.SessionBestLapTime", "conversion": "timespan_ms" },
    "session.lap.estimated_time": { "expression": "(timespantoseconds([DataCorePlugin.GameData.NewData.BestLapTime]) + isnull([PersistantTrackerPlugin.SessionBestLiveDeltaSeconds], 0)) * 1000", "format": "0" },
    "session.lap.delta": { "property": "PersistantTrackerPlugin.SessionBestLiveDeltaSeconds", "scale": 1000, "format": "0" },
    "session.lap.delta_best": { "property": "PersistantTrackerPlugin.SessionBestLiveDeltaSeconds", "scale": 1000, "format": "0" },
    "session.lap.delta_session_best": { "property": "PersistantTrackerPlugin.SessionBestLiveDeltaSeconds", "scale": 1000, "format": "0" },
