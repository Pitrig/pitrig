    "session.lap.valid": { "expression": "if(isnull([DataCorePlugin.GameData.NewData.CurrentLapInvalid], '') = '', '', if([DataCorePlugin.GameData.NewData.CurrentLapInvalid], false, true))", "conversion": "boolean" },
    "session.sector.current": { "property": "DataCorePlugin.GameData.NewData.CurrentSectorIndex", "format": "0" },
